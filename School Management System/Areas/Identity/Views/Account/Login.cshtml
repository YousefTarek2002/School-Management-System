@model School.Models.VM.LoginVM
@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Login</title>
<link href="https://fonts.googleapis.com/css?family=Montserrat:400,800" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css" />

<style>
body {
    background: #f6f5f7;
    font-family: 'Montserrat', sans-serif;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
}
.container-login {
    background-color: #fff;
    border-radius: 10px;
    box-shadow: 0 14px 28px rgba(0,0,0,0.25),0 10px 10px rgba(0,0,0,0.22);
    width: 400px;
    max-width: 100%;
    padding: 50px 30px;
    text-align: center;
    position: relative;
    animation: fadeIn 0.8s ease;
}
h1 { margin-bottom: 20px; font-weight: 700; color: #333; }
input { width: 100%; padding: 12px 15px; margin: 8px 0; border: none; border-radius: 5px; background: #eee; }
button { margin-top: 20px; width: 100%; padding: 12px; border: none; border-radius: 20px; background: #FF4B2B; color: #fff; font-weight: bold; cursor: pointer; transition: 0.3s; }
button:hover { background: #FF416C; }
a { display: block; margin: 10px 0; color: #FF4B2B; text-decoration: none; }
a:hover { text-decoration: underline; color: #FF416C; }
.text-danger { font-size: 13px; }
.remember-me {
    display: flex;
    align-items: center;
    margin-top: 10px;
    font-size: 14px;
    color: #333;
}

.remember-me input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border: 2px solid #FF4B2B;
    border-radius: 4px;
    margin-right: 10px;
    position: relative;
    cursor: pointer;
    transition: background 0.3s;
}

.remember-me input[type="checkbox"]:checked {
    background: #FF4B2B;
}

.remember-me input[type="checkbox"]:checked::after {
    content: '✔';
    position: absolute;
    top: 0;
    left: 3px;
    font-size: 14px;
    color: white;
}
</style>
</head>
<body>

<div class="container-login">
    <h1>Login</h1>
    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="UserNameOREmail" placeholder="Username or Email" />
        <span asp-validation-for="UserNameOREmail" class="text-danger"></span>

        <input asp-for="Password" type="password" placeholder="Password" />
        <span asp-validation-for="Password" class="text-danger"></span>

       <!-- استبدل div الخاص بـ RememberMe -->
<div class="remember-me">
    <input asp-for="RememberMe" id="rememberMe" type="checkbox" />
    <label for="rememberMe">Remember Me</label>
</div>

        <button type="submit">Login</button>
    </form>

    <a asp-action="Register">Create Account</a>
    <a asp-action="ForgetPassword">Forgot Password?</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

</body>
</html>