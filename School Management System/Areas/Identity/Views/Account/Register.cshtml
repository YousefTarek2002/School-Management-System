@model School.Models.VM.RegisterVM
@{
    ViewData["Title"] = "Register";
    Layout = "_AccountLayout";
}

<div class="w-full max-w-md bg-white dark:bg-gray-700 rounded-lg shadow p-8">
    <h1 class="text-3xl font-extrabold text-center mb-6">Register</h1>

    <form asp-action="Register" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

        <input asp-for="Name" placeholder="Full Name"
               class="w-full rounded-md border-gray-300 px-3 py-2 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
        <span asp-validation-for="Name" class="text-red-500 text-sm"></span>

        <input asp-for="UserName" placeholder="Username"
               class="w-full rounded-md border-gray-300 px-3 py-2 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
        <span asp-validation-for="UserName" class="text-red-500 text-sm"></span>

        <input asp-for="Email" placeholder="Email"
               class="w-full rounded-md border-gray-300 px-3 py-2 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
        <span asp-validation-for="Email" class="text-red-500 text-sm"></span>

        <input asp-for="Password" type="password" placeholder="Password"
               class="w-full rounded-md border-gray-300 px-3 py-2 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
        <span asp-validation-for="Password" class="text-red-500 text-sm"></span>

        <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password"
               class="w-full rounded-md border-gray-300 px-3 py-2 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>

        <button type="submit" class="w-full py-2 px-4 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">Register</button>
    </form>

    <!-- Or continue with -->
    <div class="mt-6 text-center relative">
        <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-300 dark:border-gray-600"></div>
        </div>
        <span class="relative bg-white dark:bg-gray-700 px-2 text-gray-500 dark:text-gray-300">Or continue with</span>
    </div>

    <!-- Social Buttons -->
    <div class="mt-6 grid grid-cols-3 gap-3">
        <!-- Google -->
        <a href="@Url.Action("ExternalLogin", "Account", new { provider = "Google", returnUrl = "/" })"
               class="flex justify-center items-center rounded-md border border-gray-300 bg-white dark:bg-gray-800 px-4 py-2 text-gray-500 dark:text-white hover:bg-gray-50 dark:hover:bg-gray-700">
            <span class="sr-only">Sign in with Google</span>
            <img class="h-5 w-5" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg" alt="Google" />
        </a>

        <!-- GitHub -->
        <a href="@Url.Action("ExternalLogin", "Account", new { provider = "GitHub", returnUrl = "/" })"
               class="flex justify-center items-center rounded-md border border-gray-300 bg-white dark:bg-gray-800 px-4 py-2 text-gray-500 dark:text-white hover:bg-gray-50 dark:hover:bg-gray-700">
            <span class="sr-only">Sign in with GitHub</span>
            <img class="h-5 w-5" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg" alt="GitHub" />
        </a>

        <!-- Facebook -->
        <a href="@Url.Action("ExternalLogin", "Account", new { provider = "Facebook", returnUrl = "/" })"
               class="flex justify-center items-center rounded-md border border-gray-300 bg-white dark:bg-gray-800 px-4 py-2 text-gray-500 dark:text-white hover:bg-gray-50 dark:hover:bg-gray-700">
            <span class="sr-only">Sign in with Facebook</span>
            <img class="h-5 w-5" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/facebook/facebook-original.svg" alt="Facebook" />
        </a>
    </div>

    <div class="mt-6 text-center text-sm dark:text-gray-300">
        Already have an account?
        <a asp-action="Login" class="text-indigo-600 font-semibold hover:underline dark:text-indigo-100">Login</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}