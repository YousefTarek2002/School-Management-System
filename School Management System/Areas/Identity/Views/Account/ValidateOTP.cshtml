@model School.Models.VM.ValidateOTP
@{
    ViewData["Title"] = "Validate OTP";
    Layout = "_AccountLayout";
}

<div class="w-full max-w-md bg-white dark:bg-gray-700 rounded-lg shadow p-8">
    <h1 class="text-3xl font-extrabold text-center mb-6">Validate OTP</h1>

    <form asp-action="ValidateOTP" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

        <input type="hidden" asp-for="UserId" />
        <input asp-for="OTP" placeholder="Enter OTP" class="w-full rounded-md border-gray-300 px-3 py-2 dark:bg-gray-800 dark:border-gray-600 dark:text-white" />
        <span asp-validation-for="OTP" class="text-red-500 text-sm"></span>

        <button type="submit" class="w-full py-2 px-4 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">Validate OTP</button>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}