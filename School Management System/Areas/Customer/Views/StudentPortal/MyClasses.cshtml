@model IEnumerable<ClassEnrollment>
@{
    ViewData["Title"] = "My Classes";
}

<div class="content container-fluid">
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="page-title">My Classes</h3>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item active">Dashboard</li>
                    <li class="breadcrumb-item active">My Classes</li>
                </ul>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="row">
            <div class="col-12 text-center py-5">
                <i class="fas fa-graduation-cap fa-4x text-muted mb-3"></i>
                <p class="text-muted">No classes enrolled yet</p>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var enrollment in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card class-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title mb-0">@enrollment.Class.Name</h5>
                                <span class="badge bg-success">Active</span>
                            </div>
                            @if (enrollment.Class.Teacher != null)
                            {
                                <div class="teacher-info mb-3">
                                    <i class="fas fa-chalkboard-teacher text-primary"></i>
                                    <strong>@enrollment.Class.Teacher.Name</strong>
                                </div>
                            }
                           
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
