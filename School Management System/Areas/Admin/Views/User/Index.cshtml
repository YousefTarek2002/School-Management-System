@model IEnumerable<UserVM>
@{
    ViewData["Title"] = "Users";
  
}

<div class="page-header">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h4 class="mb-0">
                <i class="fas fa-users me-2 text-primary"></i>
                Users <span class="badge bg-primary ms-2">@Model.Count()</span>
            </h4>
        </div>

        <div class="col-md-6 text-end">
            <div class="d-flex gap-2 justify-content-end align-items-center">
                <form method="get" class="d-flex gap-2">
                    <input type="text" name="search" value="@ViewBag.Search"
                           class="form-control shadow-sm"
                           style="width: 280px;"
                           placeholder="🔍 Search by name, email, or role">
                    <button class="btn btn-primary shadow-sm px-3">
                        <i class="fas fa-search"></i>
                    </button>
                </form>

                <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
                    <i class="fas fa-plus me-2"></i> Add User
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ALERTS -->
@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        @TempData["error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- USERS TABLE -->
<div class="card mt-3 shadow-sm">
    <div class="card-body p-3">
        <table class="table table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    int index = ((ViewBag.CurrentPage ?? 1) - 1) * 20 + 1;
                    foreach (var user in Model)
                    {
                        <tr>
                            <td>@index</td>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-danger"
                                   onclick="return confirm('Delete this user?')">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No users found.</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- PAGINATION -->
        <nav>
            <ul class="pagination justify-content-center">
                @{
                    int current = ViewBag.CurrentPage ?? 1;
                    int total = ViewBag.TotalPages ?? 1;

                    if (current > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(current-1)" asp-route-search="@ViewBag.Search">Previous</a>
                        </li>
                    }

                    for (int i = 1; i <= total; i++)
                    {
                        <li class="page-item @(i==current ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                        </li>
                    }

                    if (current < total)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(current+1)" asp-route-search="@ViewBag.Search">Next</a>
                        </li>
                    }
                }
            </ul>
        </nav>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}