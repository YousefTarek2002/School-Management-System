@model StudentDetailsVM
@{
    ViewData["Title"] = "Student Details";
}

<style>
    /* ===== MAIN CONTAINER ===== */
    .profile-container {
        background: linear-gradient(135deg, #f8fbff 0%, #e8f4f8 100%);
        min-height: 100vh;
        padding: 40px 0;
    }

    /* ===== BREADCRUMB ===== */
    .breadcrumb-modern {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        border-radius: 20px;
        padding: 25px 35px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
    }

    /* ===== PROFILE HEADER ===== */
    .profile-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 25px;
        padding: 40px;
        color: white;
        position: relative;
        overflow: hidden;
        margin-bottom: 30px;
        box-shadow: 0 20px 60px rgba(102, 126, 234, 0.3);
        display: flex;
        align-items: center;
        min-height: 180px;
    }

    .profile-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        animation: float 8s ease-in-out infinite;
    }
 
    .profile-avatar {
        width: 120px;
        height: 120px;
        background: rgba(255,255,255,0.25);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        font-weight: 800;
        backdrop-filter: blur(20px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        position: relative;
        z-index: 2;
        border: 5px solid rgba(255,255,255,0.3);
        flex-shrink: 0;
        margin-right: 30px;
    }

    .profile-hero-content {
        flex: 1;
        position: relative;
        z-index: 2;
    }

    /* ===== INFO CARDS ===== */
    .info-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.08);
        overflow: hidden;
        background: white;
        transition: all 0.4s ease;
        height: 100%;
    }

    .info-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 30px 70px rgba(0,0,0,0.15);
    }

    .detail-item {
        padding: 30px 35px;
        border-bottom: 1px solid #f1f3f4;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
    }

    .detail-item:last-child {
        border-bottom: none;
    }

    .detail-item:hover {
        background: linear-gradient(135deg, #f8f9ff 0%, #e8f0fe 100%);
        transform: translateX(10px);
    }

    .detail-icon {
        width: 70px;
        height: 70px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-right: 25px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        flex-shrink: 0;
    }

    /* ===== STATS CARDS ===== */
    .stats-grid {
        gap: 25px;
    }

    .stat-card {
        border: none;
        border-radius: 20px;
        padding: 35px 25px;
        text-align: center;
        height: 100%;
        position: relative;
        overflow: hidden;
        transition: all 0.4s ease;
        box-shadow: 0 15px 40px rgba(0,0,0,0.08);
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient(90deg, #ffffff, rgba(255,255,255,0.7), #ffffff);
        animation: shimmer 3s infinite;
    }
 

    .stat-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 25px 60px rgba(0,0,0,0.15);
    }

    .stat-icon {
        width: 80px;
        height: 80px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        margin: 0 auto 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    .stat-number {
        font-size: 48px;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 12px;
    }

    .stat-label {
        font-size: 16px;
        font-weight: 600;
        opacity: 0.9;
    }

    .classes-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: center;
    }

    .class-badge {
        background: linear-gradient(135deg, #007bff, #0056b3);
        color: white;
        padding: 12px 22px;
        border-radius: 25px;
        font-weight: 700;
        font-size: 14px;
        box-shadow: 0 6px 20px rgba(0,123,255,0.3);
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .class-badge:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(0,123,255,0.4);
    }

    /* ===== BUTTONS ===== */
    .btn-modern {
        padding: 16px 40px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 16px;
        border: none;
        transition: all 0.4s ease;
        box-shadow: 0 10px 30px rgba(13,110,253,0.4);
        position: relative;
        overflow: hidden;
        min-height: 56px;
    }

    .btn-primary-modern {
        background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
        color: white;
    }

    .btn-secondary-modern {
        background: linear-gradient(135deg, #6c757d 0%, #5c636a 100%);
        color: white;
        box-shadow: 0 10px 30px rgba(108,117,125,0.4);
    }

    .btn-modern:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 50px rgba(13,110,253,0.6);
        color: white !important;
    }

    
</style>
<div >
  

    <!-- STUDENT HERO -->
    <div class="row justify-content-center mb-5">
        <div class="col-xl-10 col-lg-11">
            <div class="profile-hero position-relative">
                <div class="profile-avatar">
                    @{
                        var initials = $"{Model.FirstName[0]}{Model.LastName[0]}".ToUpper();
                    }
                    @initials
                </div>
                <div class="profile-hero-content">
                    <h1 class="display-5 fw-bold mb-2">@Model.FirstName @Model.LastName</h1>
                    <p class="lead mb-3">معلم متميز في المدرسة</p>
                    <span class="badge bg-light text-dark px-4 py-2 fs-6">
                        <i class="fas fa-user-graduate me-2"></i>Student
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- MAIN INFO CARD -->
        <div class="col-xl-8 col-lg-8">
            <div class="card info-card shadow-xl h-100">
                <div class="card-header p-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                    <h3 class="mb-0 fw-bold">
                        <i class="fas fa-user-circle me-3"></i>
                        Personal Information
                    </h3>
                </div>
                <div class="card-body p-0">
                    <div class="detail-item">
                        <div class="detail-icon" style="background: linear-gradient(135deg, #28a745, #20c997); color: white;">
                            <i class="fas fa-signature"></i>
                        </div>
                        <div>
                            <h6 class="mb-1 fw-bold text-primary">@Model.FirstName @Model.LastName</h6>
                            <small class="text-muted">Full Name</small>
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-icon" style="background: linear-gradient(135deg, #17a2b8, #138496); color: white;">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div>
                            <h6 class="mb-1 fw-bold">@Model.Email</h6>
                            <small class="text-muted">Email Address</small>
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-icon" style="background: linear-gradient(135deg, #ffc107, #fd7e14); color: white;">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div>
                            <h6 class="mb-1 fw-bold">@Model.Phone</h6>
                            <small class="text-muted">Phone Number</small>
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-icon" style="background: linear-gradient(135deg, #6f42c1, #5a2d91); color: white;">
                            <i class="fas fa-birthday-cake"></i>
                        </div>
                        <div>
                            <h6 class="mb-1 fw-bold">@Model.BirthDate.ToString("dd MMM yyyy")</h6>
                            <small class="text-muted">Date of Birth</small>
                        </div>
                    </div>
                    @if (Model.Classes.Any())
                    {
                        <div class="detail-item">
                            <div class="detail-icon" style="background: linear-gradient(135deg, #007bff, #0056b3); color: white;">
                                <i class="fas fa-school"></i>
                            </div>
                            <div>
                                <h6 class="mb-2 fw-bold">Classes</h6>
                                <div class="classes-grid">
                                    @foreach (var cls in Model.Classes)
                                    {
                                        <span class="class-badge">@cls</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- STATS CARDS -->
        <div class="col-xl-4 col-lg-4">
            <div class="row stats-grid h-100">
                <div class="col-12">
                    <div class="stat-card" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white;">
                        <div class="stat-icon" style="background: rgba(255,255,255,0.2);">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <div class="stat-number">@Model.AttendanceCount</div>
                        <div class="stat-label">Attendance Records</div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="stat-card" style="background: linear-gradient(135deg, #007bff 0%, #0056b3 100%); color: white;">
                        <div class="stat-icon" style="background: rgba(255,255,255,0.2);">
                            <i class="fas fa-graduation-cap"></i>
                        </div>
                        <div class="stat-number">@Model.ExamResultsCount</div>
                        <div class="stat-label">Exam Results</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ACTION BUTTONS -->
    <div class="row justify-content-center mt-5">
        <div class="col-12">
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-modern btn-modern btn-lg px-6">
                    <i class="fas fa-edit me-2"></i>Edit Profile
                </a>
                <a asp-action="Index" class="btn btn-secondary-modern btn-modern btn-lg px-6">
                    <i class="fas fa-arrow-left me-2"></i>Back
                </a>
            </div>
        </div>
    </div>
</div>