@model AddStudentVM
@{
    ViewData["Title"] = "Add New Student";
}

<style>
    .form-card {
        border: none;
        border-radius: 25px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 20px 50px rgba(0,0,0,0.12);
        overflow: hidden;
        height: 100%;
    }
    .form-header {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        padding: 35px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .form-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
        animation: float 6s ease-in-out infinite;
    }
   
    .form-icon {
        width: 90px;
        height: 90px;
        background: rgba(255,255,255,0.25);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin: 0 auto 20px;
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    .input-group-modern {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
        background: white;
        height: 65px;
    }
    .input-group-modern:focus-within {
        border-color: #4facfe;
        box-shadow: 0 0 0 0.3rem rgba(79,172,254,0.15), 0 10px 25px rgba(79,172,254,0.2);
        transform: translateY(-2px);
    }
    .input-group-text-modern {
        background: linear-gradient(135deg, #f0f8ff, #e6f3ff);
        border: none;
        color: #4facfe;
        font-weight: 600;
        display: flex;
        align-items: center;
        padding: 0 20px;
        height: 100%;
    }
    .form-control-modern {
        border: none;
        padding: 20px;
        font-size: 16px;
        background: transparent;
        height: 100%;
        box-shadow: none;
    }
    .form-control-modern:focus {
        box-shadow: none;
        background: #f8fbff;
    }
    .btn-modern {
        padding: 15px 40px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 16px;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(79,172,254,0.4);
        position: relative;
        overflow: hidden;
    }
    .btn-primary-modern { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; }
    .btn-secondary-modern { 
        background: linear-gradient(135deg, #f8f9fa, #e9ecef); 
        color: #6c757d; 
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .btn-modern:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(79,172,254,0.5);
        color: white !important;
    }
    .label-modern {
        font-weight: 700;
        color: #2c3e50;
        font-size: 15px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .error-message {
        background: linear-gradient(135deg, #f8d7da, #f5c6cb);
        color: #721c24;
        border: 1px solid #f5c6cb;
        border-radius: 10px;
        padding: 12px 20px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        box-shadow: 0 5px 15px rgba(220,53,69,0.2);
    }
</style>

<div class="content container-fluid">
    <!-- PAGE HEADER -->
    <div class="row mb-5 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-2" style="color: #2c3e50;">
                <i class="fas fa-user-graduate me-3 text-primary"></i>
                Add New Student
            </h2>
            <p class="mb-0 text-muted lead">Create a new student profile for your school</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary-modern btn-lg shadow-lg px-5">
                <i class="fas fa-arrow-left me-2"></i>Back to Students
            </a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-lg mb-5" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-lg mb-5" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- FORM CARD -->
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-11">
            <div class="card form-card shadow-xl">
                <!-- HEADER -->
                <div class="form-header">
                    <div class="form-icon">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                    <h3 class="mb-2 fw-bold fs-2 position-relative">Student Information</h3>
                    <p class="mb-0 opacity-90 position-relative">Fill in the details to create new student account</p>
                </div>

                <!-- FORM BODY -->
                <div class="card-body p-5">
                    <form asp-action="Add" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div asp-validation-summary="ModelOnly" class="error-message mb-5">
                            <i class="fas fa-exclamation-circle"></i>
                            Please fix the following errors:
                        </div>

                        <!-- ROW 1: NAMES -->
                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <label class="label-modern">
                                    <i class="fas fa-user text-primary"></i>
                                    First Name
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <input asp-for="FirstName" class="form-control-modern" placeholder="Enter first name" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="label-modern">
                                    <i class="fas fa-user text-primary"></i>
                                    Last Name
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <input asp-for="LastName" class="form-control-modern" placeholder="Enter last name" />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- ROW 2: CONTACT -->
                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <label class="label-modern">
                                    <i class="fas fa-envelope text-info"></i>
                                    Email Address
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-envelope"></i>
                                    </span>
                                    <input asp-for="Email" type="email" class="form-control-modern" placeholder="student@school.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="label-modern">
                                    <i class="fas fa-phone text-success"></i>
                                    Phone Number
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-phone"></i>
                                    </span>
                                    <input asp-for="Phone" class="form-control-modern" placeholder="+20 123 456 7890" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- ROW 3: CLASS & DOB -->
                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <label class="label-modern">
                                    <i class="fas fa-calendar text-warning"></i>
                                    Date of Birth
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-calendar"></i>
                                    </span>
                                    <input asp-for="BD" type="date" class="form-control-modern" />
                                </div>
                                <span asp-validation-for="BD" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="label-modern">
                                    <i class="fas fa-school text-info"></i>
                                    Class
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-school"></i>
                                    </span>
                                    <select asp-for="ClassId" class="form-control-modern form-select" style="border: none;">
                                        <option value="">Choose a class...</option>
                                        @if (ViewBag.Classes != null)
                                        {
                                            @foreach (var cls in ViewBag.Classes)
                                            {
                                                <option value="@cls.Id">@cls.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="ClassId" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- ROW 4: PASSWORDS -->
                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <label class="label-modern">
                                    <i class="fas fa-lock text-danger"></i>
                                    Password
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-lock"></i>
                                    </span>
                                    <input asp-for="Password" type="password" class="form-control-modern" placeholder="Enter secure password" />
                                    <button type="button" class="btn btn-sm p-3" onclick="togglePassword('Password')" style="border-left: 1px solid #e9ecef;">
                                        <i class="fas fa-eye" id="togglePasswordIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="label-modern">
                                    <i class="fas fa-lock-open text-secondary"></i>
                                    Confirm Password
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-lock-open"></i>
                                    </span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control-modern" placeholder="Confirm your password" />
                                    <button type="button" class="btn btn-sm p-3" onclick="togglePassword('ConfirmPassword')" style="border-left: 1px solid #e9ecef;">
                                        <i class="fas fa-eye-slash" id="toggleConfirmPasswordIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="text-center mt-5 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-secondary-modern btn-lg me-3 px-5 shadow-lg">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary-modern btn-lg px-5 shadow-lg">
                                <i class="fas fa-plus me-2"></i>
                                Create Student Account
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Password toggle functionality
        function togglePassword(fieldId) {
            const passwordField = document.querySelector(`[name="${fieldId}"]`);
            const iconId = fieldId === 'Password' ? 'togglePasswordIcon' : 'toggleConfirmPasswordIcon';
            const icon = document.getElementById(iconId);
            
            if (passwordField.type === 'password') {
                passwordField.type = 'text';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            } else {
                passwordField.type = 'password';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            }
        }

        // Form animations
        document.addEventListener('DOMContentLoaded', function() {
            const inputs = document.querySelectorAll('.form-control-modern');
            inputs.forEach(input => {
                input.addEventListener('focus', function() {
                    this.parentElement.style.transform = 'scale(1.02)';
                });
                input.addEventListener('blur', function() {
                    this.parentElement.style.transform = 'scale(1)';
                });
            });

            // Auto-format phone number
            const phoneInput = document.querySelector('[name="Phone"]');
            phoneInput.addEventListener('input', function() {
                let value = this.value.replace(/\D/g, '');
                if (value.length >= 10) {
                    value = value.substring(0, 10);
                }
                this.value = value;
            });

            // Real-time password match validation
            const passwordField = document.querySelector('[name="Password"]');
            const confirmField = document.querySelector('[name="ConfirmPassword"]');
            
            confirmField.addEventListener('keyup', function() {
                if (this.value && this.value !== passwordField.value) {
                    this.style.borderColor = '#dc3545';
                } else {
                    this.style.borderColor = '';
                }
            });
        });
    </script>
}
