@model AddStudentVM
@{
    ViewData["Title"] = "Add New Student";
}

<style>
    /* ===== FORM CARD ===== */
    .form-card {
        border-radius: 15px;
        background: #fff;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    /* ===== HEADER ===== */
    .form-header {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
        padding: 25px 20px;
        text-align: center;
        position: relative;
    }

    .form-header-icon {
        width: 70px;
        height: 70px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin: 0 auto 15px;
    }

    /* ===== INPUTS ===== */
    .input-group-curvy {
        position: relative;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #e3e6f0;
        transition: all 0.3s ease;
        background: #f8f9fa;
    }
    .input-group-curvy:focus-within {
        border-color: #4facfe;
        box-shadow: 0 0 0 0.2rem rgba(79,172,254,0.2);
    }

    .input-group-prepend-curvy {
        background: #e3e6f0;
        display: flex;
        align-items: center;
        padding: 10px 15px;
        color: #4facfe;
    }

    .form-control-curvy {
        border: none;
        background: transparent;
        padding: 10px 15px;
        width: 100%;
    }
    .form-control-curvy:focus {
        box-shadow: none;
        background: #fefeff;
    }

    /* ===== LABELS ===== */
    .form-label-curvy {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 5px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    /* ===== BUTTONS ===== */
    .btn-curvy {
        border-radius: 50px;
        font-weight: 600;
        font-size: 15px;
        transition: all 0.3s ease;
    }

    .btn-primary-curvy {
        background: #4facfe;
        color: white;
        border: none;
    }

    .btn-primary-curvy:hover {
        background: #00f2fe;
    }

    .btn-secondary-curvy {
        background: #f8f9fa;
        color: #6c757d;
        border: 1px solid #e3e6f0;
    }

    .btn-secondary-curvy:hover {
        background: #e3e6f0;
        color: #4facfe;
    }

    /* ===== ALERTS ===== */
    .alert-success-curvy {
        background: #d4edda;
        color: #155724;
        border-radius: 10px;
        padding: 10px 15px;
        margin-bottom: 20px;
    }
    .alert-danger-curvy {
        background: #f8d7da;
        color: #721c24;
        border-radius: 10px;
        padding: 10px 15px;
        margin-bottom: 20px;
    }

    
</style>

<div class="content container-fluid">
    <!-- PAGE HEADER -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1" style="color: #2c3e50;">
                <i class="fas fa-user-graduate me-2 text-primary"></i>
                Add New Student
            </h2>
            <p class="mb-0 text-muted">Create a new student profile for your school</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary-curvy btn-lg px-4">
                <i class="fas fa-arrow-left me-1"></i>Back to Students
            </a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success-curvy">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["success"]
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger-curvy">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["error"]
        </div>
    }

    <!-- FORM CARD -->
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card form-card">
                <div class="form-header">
                    <div class="form-header-icon">
                        <i class="fas fa-user-graduate text-white"></i>
                    </div>
                    <h4 class="mb-1 fw-bold">Student Information</h4>
                    <p class="mb-0 opacity-90">Fill in the details to create new student account</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Add" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert-danger-curvy mb-3">
                            <i class="fas fa-exclamation-circle me-1"></i> Please fix the following errors:
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label-curvy">
                                    <i class="fas fa-user text-primary"></i>
                                    First Name <span class="text-danger">*</span>
                                </label>
                                <div class="input-group-curvy">
                                    <span class="input-group-prepend-curvy">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <input asp-for="FirstName" class="form-control-curvy" placeholder="Enter first name" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label-curvy">
                                    <i class="fas fa-user text-primary"></i>
                                    Last Name <span class="text-danger">*</span>
                                </label>
                                <div class="input-group-curvy">
                                    <span class="input-group-prepend-curvy">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <input asp-for="LastName" class="form-control-curvy" placeholder="Enter last name" />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="row g-3 mt-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label-curvy">
                                    <i class="fas fa-envelope text-info"></i>
                                    Email Address <span class="text-danger">*</span>
                                </label>
                                <div class="input-group-curvy">
                                    <span class="input-group-prepend-curvy">
                                        <i class="fas fa-envelope"></i>
                                    </span>
                                    <input asp-for="Email" type="email" class="form-control-curvy" placeholder="student@school.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label-curvy">
                                    <i class="fas fa-phone text-success"></i>
                                    Phone Number <span class="text-danger">*</span>
                                </label>
                                <div class="input-group-curvy">
                                    <span class="input-group-prepend-curvy">
                                        <i class="fas fa-phone"></i>
                                    </span>
                                    <input asp-for="Phone" class="form-control-curvy" placeholder="+20 123 456 7890" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="row g-3 mt-3">
                            <div class="col-md-6">
                                <label asp-for="BD" class="form-label-curvy">
                                    <i class="fas fa-calendar text-warning"></i>
                                    Date of Birth <span class="text-danger">*</span>
                                </label>
                                <div class="input-group-curvy">
                                    <span class="input-group-prepend-curvy">
                                        <i class="fas fa-calendar"></i>
                                    </span>
                                    <input asp-for="BD" type="date" class="form-control-curvy" />
                                </div>
                                <span asp-validation-for="BD" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ClassId" class="form-label-curvy">
                                    <i class="fas fa-school text-info"></i>
                                    Class <span class="text-danger">*</span>
                                </label>
                                <div class="input-group-curvy">
                                    <span class="input-group-prepend-curvy">
                                        <i class="fas fa-school"></i>
                                    </span>
                                    <select asp-for="ClassId" class="form-control-curvy">
                                        <option value="">Choose a class...</option>
                                        @if(ViewBag.Classes != null)
                                        {
                                            foreach(var cls in ViewBag.Classes)
                                            {
                                                <option value="@cls.Id">@cls.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="ClassId" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="row g-3 mt-3">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label-curvy">
                                    <i class="fas fa-lock text-danger"></i>
                                    Password <span class="text-danger">*</span>
                                </label>
                                <div class="input-group-curvy">
                                    <span class="input-group-prepend-curvy">
                                        <i class="fas fa-lock"></i>
                                    </span>
                                    <input asp-for="Password" type="password" class="form-control-curvy" placeholder="Enter secure password" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label-curvy">
                                    <i class="fas fa-lock-open text-secondary"></i>
                                    Confirm Password <span class="text-danger">*</span>
                                </label>
                                <div class="input-group-curvy">
                                    <span class="input-group-prepend-curvy">
                                        <i class="fas fa-lock-open"></i>
                                    </span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control-curvy" placeholder="Confirm your password" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-md-6 text-start">
                                <a asp-action="Index" class="btn btn-secondary-curvy btn-lg px-4">
                                    <i class="fas fa-times me-1"></i> Cancel
                                </a>
                            </div>
                            <div class="col-md-6 text-end">
                                <button type="submit" class="btn btn-primary-curvy btn-lg px-4">
                                    <i class="fas fa-save me-1"></i> Save Student
                                </button>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
