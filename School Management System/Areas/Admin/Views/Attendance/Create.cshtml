@model AttendanceVM
@{
    ViewData["Title"] = "Add Attendance";
}

<style>
    /* ===== MAIN CARD ===== */
    .form-card-modern {
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        overflow: hidden;
        border: none;
        direction: rtl;
        text-align: right;
    }

    /* ===== HEADER ===== */
    .form-header-modern {
        background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
        color: white;
        padding: 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .form-header-icon-modern {
        width: 75px;
        height: 75px;
        background: rgba(255,255,255,0.25);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        margin: 0 auto 15px;
        backdrop-filter: blur(12px);
    }

    /* ===== INPUT GROUP ===== */
    .input-group-modern {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
        background: white;
        margin-bottom: 25px;
    }

        .input-group-modern:focus-within {
            border-color: #17a2b8;
            box-shadow: 0 10px 30px rgba(23,162,184,0.25);
            transform: translateY(-2px);
        }

    .input-group-text-modern {
        background: linear-gradient(135deg, #d1ecf1, #bee5eb);
        border: none;
        color: #17a2b8;
        font-weight: 600;
        padding: 15px 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .form-control-modern {
        border: none;
        padding: 15px 20px;
        font-size: 16px;
        background: transparent;
        box-shadow: none;
        text-align: right;
    }

        .form-control-modern:focus {
            box-shadow: none;
            background: #e3f2fd;
        }

    /* ===== LABELS ===== */
    .label-modern {
        font-weight: 700;
        color: #2c3e50;
        font-size: 15px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        justify-content: flex-end;
    }

    /* ===== CHECKBOX ===== */
    .form-check-modern {
        background: linear-gradient(135deg, #d1ecf1, #bee5eb);
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
        transition: all 0.3s ease;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 15px;
    }

        .form-check-modern:hover {
            border-color: #17a2b8;
            box-shadow: 0 8px 25px rgba(23,162,184,0.15);
            transform: translateY(-1px);
        }

    .form-check-input-modern {
        transform: scale(1.5);
        accent-color: #17a2b8;
    }

    /* ===== BUTTONS ===== */
    .btn-modern {
        padding: 14px 40px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 16px;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(23,162,184,0.3);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-primary-modern {
        background: linear-gradient(135deg, #17a2b8, #138496);
        color: white;
    }

    .btn-secondary-modern {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        color: #6c757d;
        border: 1px solid #e3e6f0;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .btn-modern:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(23,162,184,0.4);
        color: white !important;
    }

    /* ===== ALERTS ===== */
    .alert-modern {
        border-radius: 12px;
        padding: 15px 20px;
        margin-bottom: 25px;
        border: none;
        font-weight: 500;
        direction: rtl;
        text-align: right;
    }
</style>

<div class="content container-fluid" dir="rtl">
    <!-- PAGE HEADER -->
    <div class="row mb-5 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1" style="color: #2c3e50;">
                <i class="fas fa-calendar-check me-2 text-info"></i>
                إضافة سجل حضور
            </h2>
            <p class="mb-0 text-muted fs-6">تسجيل حضور الطلاب لليوم</p>
        </div>
        <div class="col-md-4 text-start">
            <a asp-action="Index" class="btn btn-secondary-modern btn-lg px-4">
                <i class="fas fa-arrow-left me-1"></i>عودة للحضور
            </a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-modern shadow-sm">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["success"]
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-modern shadow-sm">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["error"]
        </div>
    }

    <!-- FORM CARD -->
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card form-card-modern shadow-lg">
                <div class="form-header-modern">
                    <div class="form-header-icon-modern">
                        <i class="fas fa-calendar-check text-white"></i>
                    </div>
                    <h4 class="mb-1 fw-bold">بيانات الحضور</h4>
                    <p class="mb-0 opacity-90">املأ البيانات لتسجيل الحضور</p>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-modern mb-5 shadow-sm">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            يرجى تصحيح الأخطاء التالية:
                        </div>

                        <!-- STUDENT SELECT -->
                        <div class="mb-5">
                            <label class="label-modern">
                                <i class="fas fa-user-graduate text-primary"></i>
                                الطالب <span class="text-danger">*</span>
                            </label>
                            <div class="input-group-modern">
                                <span class="input-group-text-modern">
                                    <i class="fas fa-user-graduate"></i>
                                </span>
                                <select asp-for="StudentId" class="form-control-modern form-select" asp-items="Model.Students">
                                    <option value="">-- اختر الطالب --</option>
                                </select>
                            </div>
                            <span class="text-danger">@Html.ValidationMessageFor(m => m.StudentId)</span>
                        </div>

                        <!-- CLASS SELECT -->
                        <div class="mb-5">
                            <label class="label-modern">
                                <i class="fas fa-school text-info"></i>
                                الصف <span class="text-danger">*</span>
                            </label>
                            <div class="input-group-modern">
                                <span class="input-group-text-modern">
                                    <i class="fas fa-school"></i>
                                </span>
                                <select asp-for="ClassId" class="form-control-modern form-select" asp-items="Model.Classes">
                                    <option value="">-- اختر الصف --</option>
                                </select>
                            </div>
                            <span class="text-danger">@Html.ValidationMessageFor(m => m.ClassId)</span>
                        </div>

                        <!-- DATE -->
                        <div class="mb-5">
                            <label class="label-modern">
                                <i class="fas fa-calendar text-warning"></i>
                                التاريخ <span class="text-danger">*</span>
                            </label>
                            <div class="input-group-modern">
                                <span class="input-group-text-modern">
                                    <i class="fas fa-calendar"></i>
                                </span>
                                <input asp-for="Date" type="date" class="form-control-modern" />
                            </div>
                            <span class="text-danger">@Html.ValidationMessageFor(m => m.Date)</span>
                        </div>

                        <!-- STATUS CHECKBOX -->
                        <div class="mb-5">
                            <label class="form-check-modern" style="cursor: pointer;">
                                <input asp-for="Status" class="form-check-input-modern" type="checkbox" />
                                <span style="font-weight: 700; font-size: 16px;">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    الحاضر
                                </span>
                            </label>
                            <small class="text-muted d-block mt-2">
                                ضع علامة إذا كان الطالب حاضر
                            </small>
                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="text-center pt-4 border-top">
                            <a asp-action="Index" class="btn btn-secondary-modern btn-lg me-3 px-5 shadow-sm">
                                <i class="fas fa-arrow-left me-2"></i>عودة
                            </a>
                            <button type="submit" class="btn btn-primary-modern btn-lg px-5 shadow-sm">
                                <i class="fas fa-save me-2"></i>حفظ الحضور
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
