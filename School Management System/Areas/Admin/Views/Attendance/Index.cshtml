@using School.Models.VM
@model IEnumerable<AttendanceVM>

<style>
    .attendance-card {
        border: none;
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: all 0.4s ease;
        height: 100%;
        overflow: hidden;
        position: relative;
    }

    .attendance-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }

    .status-indicator {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
    }

    .status-present { background: linear-gradient(135deg, #28a745, #20c997); }
    .status-absent { background: linear-gradient(135deg, #dc3545, #c82333); }

    .attendance-avatar {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        font-size: 30px;
        font-weight: 700;
        border-radius: 50%;
        margin: 25px auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }

    .attendance-name {
        font-size: 22px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 10px;
        text-align: center;
    }

    .attendance-name a {
        color: inherit;
        text-decoration: none;
    }

    .attendance-name a:hover {
        color: #667eea;
    }

    .attendance-badge {
        padding: 8px 16px;
        border-radius: 25px;
        font-size: 13px;
        font-weight: 600;
        display: inline-block;
        margin: 5px;
    }

    .badge-class {
        background: linear-gradient(45deg, #17a2b8, #138496);
        color: white;
    }

    .badge-date {
        background: linear-gradient(45deg, #6f42c1, #6610f2);
        color: white;
    }

    .badge-present {
        background: linear-gradient(45deg, #28a745, #20c997);
        color: white;
    }

    .badge-absent {
        background: linear-gradient(45deg, #dc3545, #c82333);
        color: white;
    }

    .card-actions {
        padding: 20px;
        border-top: 1px solid #eee;
        background: #fafbfc;
        display: flex;
        gap: 8px;
        justify-content: center;
    }

    .btn-action {
        flex: 1;
        padding: 10px 15px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        border: none;
        transition: all 0.3s ease;
    }

    .btn-details { background: linear-gradient(45deg, #17a2b8, #138496); color: white; }
    .btn-edit { background: linear-gradient(45deg, #28a745, #20c997); color: white; }
    .btn-delete { background: linear-gradient(45deg, #dc3545, #c82333); color: white; }

    .btn-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        color: white !important;
    }

    .empty-state {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        border-radius: 25px;
        padding: 80px 40px;
        text-align: center;
        border: 2px dashed #dee2e6;
        margin: 40px 0;
    }
</style>

<form method="post">
    @Html.AntiForgeryToken()
</form>

<div class="content container-fluid">

<!-- HEADER -->

<div class="page-header">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h4 class="mb-0">
                <i class="fas fa-calendar-check me-2 text-primary"></i>
                Attendance <span class="badge bg-primary ms-2">@Model.Count()</span>
            </h4>
        </div>
         
    <div class="col-md-6 text-end">
        <div class="d-flex gap-2 justify-content-end align-items-center">

            <form method="get" class="d-flex gap-2">
                <input id="searchInput"
                       type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control shadow-sm"
                       style="width: 280px;"
                       placeholder="🔍 Search by student name...">
                <button class="btn btn-primary shadow-sm px-3">
                    <i class="fas fa-search"></i>
                </button>
            </form>

            <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
                <i class="fas fa-plus me-2"></i>Add Record
            </a>
        </div>
    </div>
</div> 

</div>

<!-- GRID -->

<div class="row mt-4">

@if (!Model.Any())
{ <div class="col-12 text-center py-5"> <div class="empty-state"> <i class="fas fa-calendar-times fa-5x text-muted mb-4"></i> <h3 class="text-muted">No Attendance Records</h3> <a asp-action="Create" class="btn btn-primary mt-3">Add First Record</a> </div> </div>
}
else
{
@foreach (var att in Model)
{
<div class="col-xl-3 col-lg-4 col-md-6 mb-4 attendance-item"
data-name="@(att.StudentName?.ToLower() ?? "")">
 
        <div class="card attendance-card h-100">

            <div class="status-indicator @(att.StatusText?.Trim() == "حاضر" ? "status-present" : "status-absent")"></div>

            <div class="text-center pt-4">
                <div class="attendance-avatar">
                    @(string.IsNullOrEmpty(att.StudentName) ? "S" : att.StudentName[0].ToString().ToUpper())
                </div>

                <div class="attendance-name">
                    <a asp-action="Details" asp-route-id="@att.Id">
                        @att.StudentName
                    </a>
                </div>
            </div>

            <div class="px-4 pb-4 text-center">
                <span class="attendance-badge badge-class">
                    @att.ClassName
                </span>

                <span class="attendance-badge badge-date">
                    @att.Date.ToString("yyyy/MM/dd")
                </span>

                <span class="attendance-badge @(att.StatusText?.Trim() == "حاضر" ? "badge-present" : "badge-absent")">
                    @att.StatusText
                </span>
            </div>

            <div class="card-actions">
               

                <a asp-action="Edit" asp-route-id="@att.Id" class="btn-action btn-edit">
                    <i class="fas fa-edit"></i> Edit
                </a>

                <button onclick="deleteAttendance(@att.Id, '@att.StudentName')" class="btn-action btn-delete">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </div>

        </div>
    </div>
} 
}

</div>


    <!-- PAGINATION -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            <ul class="pagination">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? " disabled" : "")">
                    <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)&search=@ViewBag.Search">Prev</a>
                </li>
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? " active"
                                                  : "" )">
                <a class="page-link" href="?page=@i&search=@ViewBag.Search">@i</a>
            </li>
        }
        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? " disabled" : "")">
            <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)&search=@ViewBag.Search">Next</a>
        </li>
    </ul>
</div>
    }

</div>


@section Scripts{

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
function deleteAttendance(id, name){
    Swal.fire({
        title: `Delete "${name}"?`,
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes",
        cancelButtonText: "Cancel"
    }).then(result => {
        if(result.isConfirmed){

            fetch(`/Admin/Attendance/Delete/${id}`, {
                method: "POST",
                headers: {
                    'RequestVerificationToken':
                        document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: "success",
                        title: "Deleted!",
                        timer: 1200,
                        showConfirmButton: false
                    });
                    setTimeout(() => location.reload(), 1200);
                } else {
                    Swal.fire("Error", data.message, "error");
                }
            });
        }
    });
}

// Live Search
document.getElementById('searchInput')?.addEventListener('keyup', function() {
    const value = this.value.toLowerCase().trim();

    document.querySelectorAll('.attendance-item').forEach(item => {
        const name = item.dataset.name;
        item.style.display = name.includes(value) ? '' : 'none';
    });
});
</script>

}
