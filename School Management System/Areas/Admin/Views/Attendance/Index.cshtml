@using School.Models.VM
@model IEnumerable<AttendanceVM>

<style>
    .attendance-card {
        border: none;
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: all 0.4s ease;
        height: 100%;
        overflow: hidden;
        position: relative;
    }
    .attendance-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }
    .attendance-card.present {
        border-left: 5px solid #28a745;
        background: linear-gradient(145deg, #d4edda, #c3e6cb);
    }
    .attendance-card.absent {
        border-left: 5px solid #dc3545;
        background: linear-gradient(145deg, #f8d7da, #f5c6cb);
    }
    .status-indicator {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 3px solid white;
        background: #28a745;
        box-shadow: 0 2px 8px rgba(40,167,69,0.4);
    }
    .status-indicator.absent {
        background: #dc3545;
        box-shadow: 0 2px 8px rgba(220,53,69,0.4);
        animation: shake 0.5s ease-in-out infinite alternate;
    }
    .attendance-avatar {
        width: 80px;
        height: 80px;
        border-radius: 15px;
        font-size: 28px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 25px auto 20px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.2);
        color: white;
        text-decoration: none;
    }
    .avatar-present { background: linear-gradient(135deg, #28a745, #20c997); }
    .avatar-absent { background: linear-gradient(135deg, #dc3545, #c82333); }
    .attendance-name {
        font-size: 22px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 10px;
        line-height: 1.3;
    }
    .attendance-name a { color: inherit; text-decoration: none; }
    .attendance-name a:hover { color: #007bff; }
    .status-badge {
        padding: 10px 20px;
        border-radius: 25px;
        font-size: 15px;
        font-weight: 700;
        display: inline-block;
        margin: 15px 0;
        border: 2px solid;
    }
    .status-present-badge {
        background: rgba(40,167,69,0.1);
        color: #28a745;
        border-color: #28a745;
    }
    .status-absent-badge {
        background: rgba(220,53,69,0.1);
        color: #dc3545;
        border-color: #dc3545;
    }
    .attendance-meta {
        color: #6c757d;
        font-size: 14px;
        margin-bottom: 15px;
    }
    .card-actions {
        padding: 20px;
        border-top: 1px solid #eee;
        background: #fafbfc;
        display: flex;
        gap: 8px;
        justify-content: center;
    }
    .btn-action {
        flex: 1;
        padding: 10px 15px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-edit { background: linear-gradient(45deg, #28a745, #20c997); color: white; }
    .btn-delete { background: linear-gradient(45deg, #dc3545, #c82333); color: white; }
    .btn-action:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.2); color: white !important; }
  
</style>

<div class="content container-fluid">
    <!-- HEADER -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h4 class="mb-0">
                    <i class="fas fa-calendar-check me-2 text-primary"></i>
                    Attendance <span class="badge bg-primary ms-2">@Model.Count()</span>
                </h4>
            </div>
            <div class="col-md-6 text-end">
                <div class="d-flex gap-2 justify-content-end align-items-center">
                    <input type="text" id="searchInput" class="form-control shadow-sm" 
                           style="width: 280px;" placeholder="🔍 Search by student name...">
                    <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
                        <i class="fas fa-plus me-2"></i>New Attendance
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mt-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- GRID -->
    <div class="row mt-4" id="attendanceGrid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="empty-state">
                    <i class="fas fa-calendar-check fa-5x text-muted mb-4 opacity-75"></i>
                    <h3 class="text-muted mb-3">No Attendance Records</h3>
                    <p class="lead text-muted mb-4">Start tracking attendance</p>
                    <a asp-action="Create" class="btn btn-primary btn-lg shadow-lg px-5">
                        <i class="fas fa-plus me-3"></i>New Record
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var attendance in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-4 attendance-item"
                     data-name="@(attendance.StudentName ?? "").ToLower()">
                    
                    <div class="card attendance-card @(attendance.StatusText == "Present" ? "present" : "absent") h-100 position-relative">
                        <!-- STATUS INDICATOR -->
                        <div class="status-indicator @(attendance.StatusText != "Present" ? "absent" : "")"></div>

                        <!-- AVATAR & NAME -->
                        <div class="text-center pt-4">
                            <a asp-action="Edit" asp-route-id="@attendance.Id" 
                               class="attendance-avatar @(attendance.StatusText == "Present" ? "avatar-present" : "avatar-absent") d-inline-block">
                                @(string.IsNullOrEmpty(attendance.StudentName) ? "A" : attendance.StudentName[0].ToString().ToUpper())
                            </a>
                            <h5 class="attendance-name">
                                <a asp-action="Edit" asp-route-id="@attendance.Id">@(attendance.StudentName ?? "Unnamed")</a>
                            </h5>
                        </div>

                        <!-- STATUS & META -->
                        <div class="px-4 pb-4">
                            <span class="status-badge @(attendance.StatusText == "Present" ? "status-present-badge" : "status-absent-badge")">
                                @attendance.StatusText
                            </span>
                            <div class="attendance-meta mt-3">
                                <i class="fas fa-calendar me-1"></i> @attendance.Date.ToString("dd/MM/yyyy")
                            </div>
                            <div class="attendance-meta">
                                <i class="fas fa-school me-1"></i> @(attendance.ClassName ?? "No Class")
                            </div>
                        </div>

                        <!-- ACTIONS -->
                        <div class="card-actions">
                            <a asp-action="Edit" asp-route-id="@attendance.Id" class="btn-action btn-edit">
                                <i class="fas fa-edit me-1"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@attendance.Id" method="post" 
                                  class="d-inline" style="flex:1;" 
                                  onsubmit="return confirmDelete('@attendance.StudentName', '@attendance.Date.ToString("dd/MM/yyyy")')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-action btn-delete w-100 h-100 p-2 border-0">
                                    <i class="fas fa-trash me-1"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- SUMMARY STATS -->
    @if (Model.Any())
    {
        <div class="row mt-5">
            <div class="col-md-3">
                <div class="card text-center bg-success bg-opacity-10 border-success shadow-lg">
                    <div class="card-body">
                        <i class="fas fa-check-circle fa-3x mb-3 text-success"></i>
                        <h3>@Model.Count(a => a.StatusText == "Present")</h3>
                        <p class="fw-semibold text-success">Present</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-danger bg-opacity-10 border-danger shadow-lg">
                    <div class="card-body">
                        <i class="fas fa-times-circle fa-3x mb-3 text-danger"></i>
                        <h3>@Model.Count(a => a.StatusText != "Present")</h3>
                        <p class="fw-semibold text-danger">Absent</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-info bg-opacity-10 border-info shadow-lg">
                    <div class="card-body">
                        <i class="fas fa-calendar fa-3x mb-3 text-info"></i>
                        <h3>@Model.Count()</h3>
                        <p class="fw-semibold text-info">Total</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-primary bg-opacity-10 border-primary shadow-lg">
                    <div class="card-body">
                        <i class="fas fa-school fa-3x mb-3 text-primary"></i>
                        <h3>@Model.Select(a => a.ClassName).Distinct().Count()</h3>
                        <p class="fw-semibold text-primary">Classes</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // 🔍 البحث بالـ StudentName
        document.getElementById('searchInput').addEventListener('keyup', function() {
            const value = this.value.toLowerCase().trim();
            document.querySelectorAll('.attendance-item').forEach(item => {
                const name = item.dataset.name;
                item.style.display = name.includes(value) ? '' : 'none';
            });
        });

        // Delete confirmation
        function confirmDelete(studentName, date) {
            return confirm(`⚠️ Delete attendance for "${studentName || 'Student'}" on ${date}?\n\nThis cannot be undone!`);
        }

        // Animate cards on load
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.attendance-card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(30px)';
                setTimeout(() => {
                    card.style.transition = 'all 0.6s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
}
