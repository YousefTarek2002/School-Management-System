@using School.Models.VM
@model IEnumerable<ExamResultIndexVM>

<style>
    .exam-card {
        border: none;
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: all 0.4s ease;
        height: 100%;
        overflow: hidden;
        position: relative;
    }

        .exam-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

        .exam-card.has-results {
            border-left: 5px solid #28a745;
        }

        .exam-card.no-results {
            border-left: 5px solid #ffc107;
        }

    .exam-avatar {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #007bff, #0056b3);
        color: white;
        font-size: 30px;
        font-weight: 700;
        border-radius: 50%;
        margin: 25px auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(0, 123, 255, 0.4);
    }

        .exam-avatar.no-results {
            background: linear-gradient(135deg, #ffc107, #ff8c00);
            box-shadow: 0 8px 25px rgba(255, 193, 7, 0.4);
        }

    .exam-name {
        font-size: 20px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 8px;
    }

    .exam-meta {
        font-size: 14px;
        color: #6c757d;
        margin-bottom: 6px;
    }

    .exam-badges {
        margin-top: 12px;
    }

    .exam-badge {
        display: inline-block;
        padding: 6px 14px;
        margin: 4px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-subject {
        background: linear-gradient(45deg, #17a2b8, #138496);
        color: white;
    }

    .badge-class {
        background: linear-gradient(45deg, #6f42c1, #6610f2);
        color: white;
    }

    .badge-count {
        background: linear-gradient(45deg, #28a745, #20c997);
        color: white;
    }

    .badge-empty {
        background: linear-gradient(45deg, #ffc107, #e0a800);
        color: #212529;
    }

    .card-actions {
        padding: 18px;
        border-top: 1px solid #eee;
        background: #fafbfc;
        display: flex;
        gap: 8px;
        justify-content: center;
    }

    .btn-action {
        flex: 1;
        padding: 10px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 13px;
        border: none;
        transition: 0.3s;
        text-align: center;
    }

    .btn-view {
        background: linear-gradient(45deg, #17a2b8, #138496);
        color: white;
    }

    .btn-edit {
        background: linear-gradient(45deg, #28a745, #20c997);
        color: white;
    }

    .btn-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        color: white !important;
    }
</style>

<div class="content container-fluid">

    <!-- HEADER -->
    <div class="page-header">
        <div class="row align-items-center">

            <div class="col-md-6">
                <h4 class="mb-0">
                    <i class="fas fa-chart-line me-2 text-primary"></i>
                    Exam Results
                    <span class="badge bg-primary ms-2">@Model.Count()</span>
                </h4>
            </div>

            <div class="col-md-6 text-end">
                <div class="d-flex gap-2 justify-content-end align-items-center">

                    <form method="get" class="d-flex gap-2">
                        <input id="searchInput"
                               type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control shadow-sm"
                               style="width: 280px;"
                               placeholder="🔍 Search Exam...">
                        <button class="btn btn-primary shadow-sm px-3">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>
 
                </div>
            </div>

        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success mt-3 shadow-sm">
            @TempData["success"]
        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger mt-3 shadow-sm">
            @TempData["error"]
        </div>
    }

    <!-- GRID -->
    <div class="row mt-4">

        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="fas fa-chart-line fa-4x text-muted mb-3"></i>
                <h4 class="text-muted">No Exams Found</h4>
            </div>
        }
        else
        {
            @foreach (var exam in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 mb-4 exam-item"
                     data-name="@(exam.ExamName ?? "").ToLower()">

                    <div class="card exam-card @(exam.HasResults ? "has-results" : "no-results")">

                        <!-- AVATAR -->
                        <div class="text-center">
                            <div class="exam-avatar @(exam.HasResults ? "" : "no-results")">
                                @(exam.ExamName?.Length > 0 ? exam.ExamName[0].ToString().ToUpper() : "E")
                            </div>

                            <div class="exam-name">
                                @(exam.ExamName ?? "Unnamed Exam")
                            </div>
                        </div>

                        <!-- DATA -->
                        <div class="text-center px-3 pb-3">

                            <div class="exam-meta">
                                <i class="fas fa-book me-1"></i>
                                @(exam.SubjectName ?? "No Subject")
                            </div>

                            <div class="exam-meta">
                                <i class="fas fa-school me-1"></i>
                                @(exam.ClassName ?? "No Class")
                            </div>

                            <div class="exam-badges">

                                <span class="exam-badge badge-count">
                                    👨‍🎓 @exam.TotalStudents Students
                                </span>

                                @if (!exam.HasResults)
                                {
                                    <span class="exam-badge badge-empty">
                                        No Results Yet
                                    </span>
                                }

                            </div>

                        </div>

                        <!-- ACTIONS -->
                        <div class="card-actions">

                            <a asp-action="ViewResults"
                                   asp-route-examId="@exam.ExamId"
                                   class="btn-action btn-view">
                                <i class="fas fa-eye"></i> View
                            </a>

                            <a asp-action="AddResults"
                                   asp-route-examId="@exam.ExamId"
                                   class="btn-action btn-edit">
                                <i class="fas fa-edit"></i>
                                @(exam.HasResults ? "Edit" : "Add")
                            </a>

                        </div>

                    </div>
                </div>
            }
        }

    </div>
    <!-- PAGINATION -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            <ul class="pagination">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)&search=@ViewBag.Search">Prev</a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i&search=@ViewBag.Search">@i</a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)&search=@ViewBag.Search">Next</a>
                </li>
            </ul>
        </div>
    }
</div>

@section Scripts {

    <script>

        // 🔍 SEARCH
        document.getElementById('searchInput').addEventListener('keyup', function () {
            let value = this.value.toLowerCase();

            document.querySelectorAll('.exam-item').forEach(item => {
                let name = item.dataset.name;
                item.style.display = name.includes(value) ? "" : "none";
            });
        });

        // ✨ ANIMATION
        document.addEventListener("DOMContentLoaded", function () {
            let cards = document.querySelectorAll(".exam-card");

            cards.forEach((card, index) => {
                card.style.opacity = "0";
                card.style.transform = "translateY(30px)";

                setTimeout(() => {
                    card.style.transition = "0.5s";
                    card.style.opacity = "1";
                    card.style.transform = "translateY(0)";
                }, index * 80);
            });
        });

    </script>

}