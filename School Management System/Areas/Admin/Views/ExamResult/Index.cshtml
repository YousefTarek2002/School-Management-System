@using School.Models.VM
@model IEnumerable<ExamResultIndexVM>

<style>
    .exam-card {
        border: none;
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: all 0.4s ease;
        height: 100%;
        overflow: hidden;
    }
    .exam-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }
    .exam-card.has-results {
        border-left: 5px solid #28a745;
        background: linear-gradient(145deg, #d4edda, #c3e6cb);
    }
    .exam-card.no-results {
        border-left: 5px solid #ffc107;
        background: linear-gradient(145deg, #fff3cd, #ffeaa7);
    }
    .exam-avatar {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        font-size: 30px;
        font-weight: 700;
        border-radius: 50%;
        margin: 25px auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4);
    }
    .exam-avatar.no-results {
        background: linear-gradient(135deg, #ffc107, #ff8c00);
        box-shadow: 0 8px 25px rgba(255, 193, 7, 0.4);
    }
    .exam-name {
        font-size: 22px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 10px;
        line-height: 1.3;
    }
    .exam-name a { color: inherit; text-decoration: none; }
    .exam-name a:hover { color: #28a745; }
    .exam-meta {
        color: #6c757d;
        font-size: 14px;
        margin-bottom: 15px;
    }
    .results-badge {
        padding: 8px 16px;
        border-radius: 25px;
        font-size: 13px;
        font-weight: 600;
        background: linear-gradient(45deg, #007bff, #0056b3);
        color: white;
        display: inline-block;
    }
    .card-actions {
        padding: 20px;
        border-top: 1px solid #eee;
        background: #fafbfc;
        display: flex;
        gap: 8px;
        justify-content: center;
    }
    .btn-action {
        flex: 1;
        padding: 10px 15px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        border: none;
        transition: all 0.3s ease;
        text-align: center;
    }
    .btn-view { background: linear-gradient(45deg, #17a2b8, #138496); color: white; }
    .btn-edit { background: linear-gradient(45deg, #28a745, #20c997); color: white; }
    .btn-action:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.2); color: white !important; }
</style>

<div class="content container-fluid">
    <!-- HEADER -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h4 class="mb-0">
                    <i class="fas fa-chart-line me-2 text-primary"></i>
                    Exam Results <span class="badge bg-primary ms-2">@Model.Count()</span>
                </h4>
            </div>
            <div class="col-md-4 text-end">
                <div class="d-flex gap-2 justify-content-end align-items-center">
                    <input type="text" id="searchInput" class="form-control shadow-sm" 
                           style="width: 280px;" placeholder="🔍 Search by exam name...">
                </div>
            </div>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mt-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- GRID -->
    <div class="row mt-4" id="examGrid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="empty-state">
                    <i class="fas fa-chart-line fa-5x text-muted mb-4 opacity-75"></i>
                    <h3 class="text-muted mb-3">No Exam Results Yet</h3>
                    <p class="lead text-muted mb-4">Get started by adding your first exam results</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var exam in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-4 exam-item"
                     data-name="@(exam.ExamName ?? "").ToLower()">
                    
                    <div class="card exam-card @(exam.HasResults ? "has-results" : "no-results") h-100">
                        <!-- AVATAR & NAME -->
                        <div class="text-center pt-4">
                            <a asp-action="ViewResults" asp-route-examId="@exam.ExamId" class="exam-avatar @(exam.HasResults ? "" : "no-results") d-inline-block">
                                @(exam.ExamName?.Length > 0 ? exam.ExamName[0].ToString().ToUpper() : "E")
                            </a>
                            <h5 class="exam-name">@exam.ExamName</h5>
                        </div>

                        <!-- META INFO -->
                        <div class="px-4 pb-3">
                            <div class="exam-meta">
                                <i class="fas fa-book me-1"></i> @(exam.SubjectName ?? "No Subject")
                            </div>
                            <div class="exam-meta">
                                <i class="fas fa-school me-1"></i> @(exam.ClassName ?? "No Class")
                            </div>
                            <div class="results-badge mt-2">
                                <i class="fas fa-users me-1"></i>@exam.TotalStudents Results
                            </div>
                        </div>

                        <!-- ACTIONS -->
                        <div class="card-actions">
                            <a asp-action="ViewResults" asp-route-examId="@exam.ExamId" class="btn-action btn-view">
                                <i class="fas fa-eye me-1"></i> View
                            </a>
                            <a asp-action="AddResults" asp-route-examId="@exam.ExamId" class="btn-action btn-edit">
                                <i class="fas fa-edit me-1"></i> @(exam.HasResults ? "Edit" : "Add") Results
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        // 🔍 البحث بالاسم بس (ExamName)
        document.getElementById('searchInput').addEventListener('keyup', function() {
            const value = this.value.toLowerCase().trim();
            document.querySelectorAll('.exam-item').forEach(item => {
                const name = item.dataset.name;
                item.style.display = name.includes(value) ? '' : 'none';
            });
        });

        // Animate cards on load
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.exam-card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(30px)';
                setTimeout(() => {
                    card.style.transition = 'all 0.6s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
}
