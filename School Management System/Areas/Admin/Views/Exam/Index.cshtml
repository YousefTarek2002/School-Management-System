@using School.Models.VM
@model IEnumerable<ExamVM>

<style>
    .exam-card {
        border: none;
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: all 0.4s ease;
        height: 100%;
        overflow: hidden;
    }
    .exam-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }
    .exam-avatar {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #17a2b8, #138496);
        color: white;
        font-size: 30px;
        font-weight: 700;
        border-radius: 50%;
        margin: 25px auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(23, 162, 184, 0.4);
    }
    .exam-name {
        font-size: 22px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 10px;
        line-height: 1.3;
    }
    .exam-name a { color: inherit; text-decoration: none; }
    .exam-name a:hover { color: #17a2b8; }
    .exam-meta {
        color: #6c757d;
        font-size: 14px;
        margin-bottom: 8px;
    }
    .students-badge {
        padding: 8px 16px;
        border-radius: 25px;
        font-size: 13px;
        font-weight: 600;
        background: linear-gradient(45deg, #28a745, #20c997);
        color: white;
        display: inline-block;
    }
    .timetable-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        background: linear-gradient(45deg, #ffc107, #ff8c00);
        color: white;
        text-decoration: none;
        display: inline-block;
        margin-top: 5px;
    }
    .card-actions {
        padding: 20px;
        border-top: 1px solid #eee;
        background: #fafbfc;
        display: flex;
        gap: 8px;
        justify-content: center;
    }
    .btn-action {
        flex: 1;
        padding: 10px 15px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-edit { background: linear-gradient(45deg, #28a745, #20c997); color: white; }
    .btn-delete { background: linear-gradient(45deg, #dc3545, #c82333); color: white; }
    .btn-action:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.2); color: white !important; }
</style>

<!-- AntiForgeryToken for AJAX -->
<form method="post">
    @Html.AntiForgeryToken()
</form>

<div class="content container-fluid">

    <!-- HEADER -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h4 class="mb-0">
                    <i class="fas fa-clipboard-list me-2 text-primary"></i>
                    Exams <span class="badge bg-primary ms-2">@Model.Count()</span>
                </h4>
            </div>
            <div class="col-md-6 text-end">
                <div class="d-flex gap-2 justify-content-end align-items-center">
                    <input type="text" id="searchInput" class="form-control shadow-sm" 
                           style="width: 280px;" placeholder="🔍 Search by exam name...">
                    <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
                        <i class="fas fa-plus me-2"></i>Add Exam
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- GRID -->
    <div class="row mt-4" id="examGrid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="empty-state">
                    <i class="fas fa-clipboard-list fa-5x text-muted mb-4 opacity-75"></i>
                    <h3 class="text-muted mb-3">No Exams Yet</h3>
                    <p class="lead text-muted mb-4">Get started by adding your first exam</p>
                    <a asp-action="Create" class="btn btn-primary btn-lg shadow-lg px-5">
                        <i class="fas fa-plus me-3"></i> Add First Exam
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var exam in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-4 exam-item"
                     data-id="@exam.Id"
                     data-name="@(exam.ExamName ?? "").ToLower()">
                    
                    <div class="card exam-card h-100">
                        <!-- AVATAR & NAME -->
                        <div class="text-center pt-4">
                            <a asp-action="Edit" asp-route-id="@exam.Id" class="exam-avatar d-inline-block">
                                @(exam.ExamName?.Length > 0 ? exam.ExamName[0].ToString().ToUpper() : "E")
                            </a>
                            <h5 class="exam-name">
                                <a asp-action="Edit" asp-route-id="@exam.Id">@(exam.ExamName ?? "Unnamed Exam")</a>
                            </h5>
                        </div>

                        <!-- META INFO -->
                        <div class="px-4 pb-3">
                            <div class="exam-meta">
                                <i class="fas fa-book me-1"></i> @(exam.SubjectName ?? "No Subject")
                            </div>
                            <div class="exam-meta">
                                <i class="fas fa-school me-1"></i> @(exam.ClassName ?? "No Class")
                            </div>
                            <div class="students-badge mt-2">
                                <i class="fas fa-users me-1"></i>@exam.StudentsCount @(exam.StudentsCount != 1 ? "Results" : "Result")
                            </div>
                            @if (!string.IsNullOrEmpty(exam.ExistingTimeTablePath))
                            {
                                <a href="@exam.ExistingTimeTablePath" target="_blank" class="timetable-badge mt-2 d-block">
                                    <i class="fas fa-file-pdf me-1"></i> Exam Schedule
                                </a>
                            }
                        </div>

                        <!-- DATE & TIME -->
                        <div class="px-3 pb-3 small text-muted text-center">
                            <div><i class="fas fa-calendar me-1 text-primary"></i> @exam.ExamDate.ToString("dd/MM/yyyy")</div>
                            <div class="mt-1"><i class="fas fa-clock me-1 text-info"></i> @exam.ExamTime.ToString(@"hh\:mm")</div>
                        </div>

                        <!-- ACTIONS -->
                        <div class="card-actions">
                            <a asp-action="Edit" asp-route-id="@exam.Id" class="btn-action btn-edit">
                                <i class="fas fa-edit me-1"></i> Edit
                            </a>
                            <button type="button" class="btn-action btn-delete"
                                    onclick="deleteExam(@exam.Id, '@exam.ExamName')">
                                <i class="fas fa-trash me-1"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- PAGINATION -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            <ul class="pagination">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)&search=@ViewBag.Search">Prev</a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i&search=@ViewBag.Search">@i</a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)&search=@ViewBag.Search">Next</a>
                </li>
            </ul>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function deleteExam(id, name) {
            Swal.fire({
                title: `Delete "${name}"?`,
                text: "This action cannot be undone!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#dc3545",
                confirmButtonText: "Yes, delete",
                cancelButtonText: "Cancel"
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/Admin/Exam/Delete/${id}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken':
                                document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                icon: "success",
                                title: "Deleted!",
                                timer: 1200,
                                showConfirmButton: false
                            });
                            const card = document.querySelector(`.exam-item[data-id='${id}']`);
                            if (card) card.remove();
                        } else {
                            Swal.fire("Error", data.message || "Something went wrong", "error");
                        }
                    })
                    .catch(err => {
                        Swal.fire("Error", "Unable to delete exam", "error");
                        console.error(err);
                    });
                }
            });
        }

        document.getElementById('searchInput')?.addEventListener('keyup', function() {
            const value = this.value.toLowerCase().trim();
            document.querySelectorAll('.exam-item').forEach(item => {
                const name = item.dataset.name || '';
                item.style.display = name.includes(value) ? '' : 'none';
            });
        });
    </script>
}