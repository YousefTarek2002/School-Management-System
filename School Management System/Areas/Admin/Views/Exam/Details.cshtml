@model School.Models.Exam
@{
    ViewData["Title"] = "Exam Details";
}

<style>
    /* ===== MAIN CONTAINER ===== */
    .profile-container {
        background: linear-gradient(135deg, #f8fbff 0%, #e8f4f8 100%);
        min-height: 100vh;
        padding: 40px 0;
    }

    /* ===== BREADCRUMB ===== */
    .breadcrumb-modern {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        border-radius: 20px;
        padding: 25px 35px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
    }

    /* ===== PROFILE HEADER ===== */
    .profile-hero {
        background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%);
        border-radius: 25px;
        padding: 40px;
        color: white;
        position: relative;
        overflow: hidden;
        margin-bottom: 30px;
        box-shadow: 0 20px 60px rgba(220,53,69,0.3);
        display: flex;
        align-items: center;
        min-height: 200px;
    }

    .profile-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        animation: float 8s ease-in-out infinite;
    }

    

    .exam-avatar {
        width: 120px;
        height: 120px;
        background: rgba(255,255,255,0.25);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        font-weight: 800;
        backdrop-filter: blur(20px);
        border: 5px solid rgba(255,255,255,0.3);
        flex-shrink: 0;
        margin-right: 30px;
        position: relative;
        z-index: 2;
        overflow: hidden;
    }

    .exam-avatar::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
        animation: rotate 10s linear infinite;
    }

    .profile-hero-content {
        flex: 1;
        position: relative;
        z-index: 2;
    }

    /* ===== INFO CARDS ===== */
    .info-section {
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.08);
        margin-bottom: 30px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: start;
    }

    .info-item {
        padding: 30px 0;
        border-right: 1px solid rgba(0,0,0,0.08);
        transition: all 0.4s ease;
    }

    .info-item:last-child {
        border-right: none;
    }

    .info-item:hover {
        transform: translateY(-5px);
    }

    .info-icon {
        width: 70px;
        height: 70px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 25px;
        color: white;
    }

    .icon-subject { background: linear-gradient(135deg, #007bff, #0056b3); }
    .icon-class { background: linear-gradient(135deg, #28a745, #20c997); }
    .icon-date { background: linear-gradient(135deg, #17a2b8, #138496); }
    .icon-time { background: linear-gradient(135deg, #ffc107, #fd7e14); }
    .icon-results { background: linear-gradient(135deg, #6f42c1, #5a2d91); }

    .info-label {
        font-weight: 700;
        color: #495057;
        font-size: 18px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        justify-content: flex-end;
    }

    .info-value {
        font-size: 32px;
        font-weight: 700;
        color: #2c3e50;
        line-height: 1.3;
    }

    /* ===== TIMETABLE DOWNLOAD ===== */
    .timetable-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.08);
        overflow: hidden;
        transition: all 0.4s ease;
    }

    .timetable-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 30px 70px rgba(0,0,0,0.15);
    }

    .file-download {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border-radius: 15px;
        padding: 30px;
        text-align: center;
        color: white;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(40,167,69,0.3);
        height: 100%;
    }

    .file-download:hover {
        transform: translateY(-5px) scale(1.02);
        color: white !important;
        box-shadow: 0 20px 40px rgba(40,167,69,0.4);
        text-decoration: none;
    }

    /* ===== BUTTONS ===== */
    .btn-modern {
        padding: 18px 45px;
        border-radius: 50px;
        font-weight: 800;
        font-size: 17px;
        border: none;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        box-shadow: 0 12px 35px rgba(13,110,253,0.4);
        position: relative;
        overflow: hidden;
        min-width: 180px;
    }

    .btn-primary-modern {
        background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
        color: white;
    }

    .btn-secondary-modern {
        background: linear-gradient(135deg, #6c757d 0%, #5c636a 100%);
        color: white;
        box-shadow: 0 12px 35px rgba(108,117,125,0.4);
    }

    .btn-modern:hover {
        transform: translateY(-6px);
        box-shadow: 0 25px 60px rgba(13,110,253,0.6);
        color: white !important;
    }

</style>

  <div >
        

        <!-- EXAM HERO -->
        <div class="row justify-content-center mb-5">
            <div class="col-xl-10 col-lg-11">
                <div class="profile-hero position-relative">
                    <div class="exam-avatar">
                        @Model.ExamName?.Substring(0, 1).ToUpper()
                    </div>
                    <div class="profile-hero-content">
                        <h1 class="display-5 fw-bold mb-3">@Model.ExamName</h1>
                        <p class="lead mb-4">امتحان شامل للطلاب</p>
                        <span class="badge bg-light text-dark px-4 py-2 fs-6">
                            <i class="fas fa-clipboard-check me-2"></i>Exam Schedule
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- MAIN INFO SECTION -->
            <div class="col-xl-8 col-lg-8">
                <div class="info-section">
                    <div class="info-grid">
                        <!-- SUBJECT -->
                        <div class="info-item">
                            <div class="info-icon icon-subject">
                                <i class="fas fa-book"></i>
                            </div>
                            <div class="info-label">
                                <i class="fas fa-book me-2 text-primary"></i>
                                <span>المادة الدراسية</span>
                            </div>
                            <div class="info-value">
                                @(Model.Subject?.Name ?? "غير محدد")
                            </div>
                        </div>

                        <!-- CLASS -->
                        <div class="info-item">
                            <div class="info-icon icon-class">
                                <i class="fas fa-school"></i>
                            </div>
                            <div class="info-label">
                                <i class="fas fa-school me-2 text-success"></i>
                                <span>الصف الدراسي</span>
                            </div>
                            <div class="info-value">
                                @(Model.Class?.Name ?? "غير محدد")
                            </div>
                        </div>

                        <!-- DATE -->
                        <div class="info-item">
                            <div class="info-icon icon-date">
                                <i class="fas fa-calendar"></i>
                            </div>
                            <div class="info-label">
                                <i class="fas fa-calendar me-2 text-info"></i>
                                <span>تاريخ الامتحان</span>
                            </div>
                            <div class="info-value">
                                @Model.ExamDate.ToString("dd MMMM yyyy")
                            </div>
                        </div>

                        <!-- TIME -->
                        <div class="info-item">
                            <div class="info-icon icon-time">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div class="info-label">
                                <i class="fas fa-clock me-2 text-warning"></i>
                                <span>وقت الامتحان</span>
                            </div>
                            <div class="info-value">
                                @Model.ExamTime.ToString(@"hh\:mm")
                            </div>
                        </div>

                        <!-- RESULTS -->
                        <div class="info-item">
                            <div class="info-icon icon-results">
                                <i class="fas fa-chart-line"></i>
                            </div>
                            <div class="info-label">
                                <i class="fas fa-chart-line me-2 text-success"></i>
                                <span>عدد النتائج</span>
                            </div>
                            <div class="info-value">
                                <span style="font-size: 48px; font-weight: 900; color: #28a745;">
                                    @(Model.ExamResults?.Count ?? 0)
                                </span>
                                <small class="ms-3 text-success fw-bold fs-5">طالب</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TIMETABLE DOWNLOAD -->
            @if (!string.IsNullOrEmpty(Model.TimeTablePath))
            {
                <div class="col-xl-4 col-lg-4">
                    <div class="timetable-card h-100">
                        <a href="@Model.TimeTablePath" target="_blank" class="file-download">
                            <i class="fas fa-file-pdf fa-3x"></i>
                            <h4 class="mb-2 fw-bold">جدول الامتحانات</h4>
                            <p class="mb-0">تحميل ملف PDF كامل</p>
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- ACTION BUTTONS -->
        <div class="row justify-content-center mt-5">
            <div class="col-12">
                <div class="action-buttons" style="background: white; border-radius: 25px; padding: 40px; box-shadow: 0 20px 50px rgba(0,0,0,0.08); display: flex; gap: 25px; justify-content: center; flex-wrap: wrap;">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-modern btn-modern btn-lg px-6">
                        <i class="fas fa-edit me-2"></i>تعديل بيانات الامتحان
                    </a>
                    <a asp-action="Index" class="btn btn-secondary-modern btn-modern btn-lg px-6">
                        <i class="fas fa-arrow-left me-2"></i>العودة للامتحانات
                    </a>
                </div>
            </div>
        </div>
    </div>