@using School.Models.VM
@model IEnumerable<ClassVM>

<style>
    .class-card {
        border: none;
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: all 0.4s ease;
        height: 100%;
        overflow: hidden;
        position: relative;
    }
    .class-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }
    .class-avatar {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        font-size: 30px;
        font-weight: 700;
        border-radius: 50%;
        margin: 25px auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(13,110,253,0.4);
        position: relative;
    }
    .class-name {
        font-size: 22px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 10px;
        line-height: 1.3;
    }
    .class-name a { color: inherit; text-decoration: none; }
    .class-name a:hover { color: #0d6efd; }
    .class-teacher {
        color: #6c757d;
        font-size: 14px;
        margin-bottom: 15px;
    }
    .class-badge {
        padding: 8px 16px;
        margin: 4px;
        border-radius: 25px;
        font-size: 13px;
        font-weight: 600;
        display: inline-block;
    }
    .badge-success { background: linear-gradient(45deg, #28a745, #20c997); color: white; }
    .badge-info { background: linear-gradient(45deg, #17a2b8, #138496); color: white; }
    .status-indicator {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 3px solid white;
        background: #28a745;
        box-shadow: 0 2px 8px rgba(40,167,69,0.4);
    }
    .card-actions {
        padding: 20px;
        border-top: 1px solid #eee;
        background: #fafbfc;
        display: flex;
        gap: 8px;
        justify-content: center;
    }
    .btn-action {
        flex: 1;
        padding: 10px 15px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-details { background: linear-gradient(45deg, #17a2b8, #138496); color: white; }
    .btn-edit { background: linear-gradient(45deg, #28a745, #20c997); color: white; }
    .btn-delete { background: linear-gradient(45deg, #dc3545, #c82333); color: white; }
    .btn-action:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.2); color: white !important; }
</style>

<div class="content container-fluid">
    <!-- HEADER -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h4 class="mb-0">
                    <i class="fas fa-school me-2 text-primary"></i>
                    Classes <span class="badge bg-primary ms-2">@Model.Count()</span>
                </h4>
            </div>
            <div class="col-md-6 text-end">
                <div class="d-flex gap-2 justify-content-end align-items-center">
                    <input type="text" id="searchInput" class="form-control shadow-sm" 
                           style="width: 280px;" placeholder="🔍 Search by class name...">
                    <a asp-action="Add" class="btn btn-primary shadow-sm px-4">
                        <i class="fas fa-plus me-2"></i>Add Class
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mt-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- GRID -->
    <div class="row mt-4" id="classGrid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="empty-state">
                    <i class="fas fa-school fa-5x text-muted mb-4 opacity-75"></i>
                    <h3 class="text-muted mb-3">No Classes Yet</h3>
                    <p class="lead text-muted mb-4">Get started by adding your first class</p>
                    <a asp-action="Add" class="btn btn-primary btn-lg shadow-lg px-5">
                        <i class="fas fa-plus me-3"></i> Add First Class
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var classItem in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-4 class-item"
                     data-name="@((classItem.Name + " " + classItem.Section).ToLower())">
                    
                    <div class="card class-card h-100 position-relative">
                        <!-- STATUS & AVATAR -->
                        <div class="status-indicator"></div>
                       <!-- AVATAR -->
<div class="text-center pt-4">
    <div class="class-avatar">
        @(classItem.Name?.Length > 0 ? classItem.Name[0].ToString().ToUpper() : "C")
    </div>
    <h5 class="class-name">
        <a asp-action="Details" asp-route-id="@classItem.Id">
            @classItem.Name - @classItem.Section
        </a>
    </h5>
</div>


                        <!-- TEACHER & STATS -->
                        <div class="px-4 pb-4">
                            <div class="class-teacher">
                                <i class="fas fa-chalkboard-teacher me-1"></i> 
                                @(classItem.TeacherName ?? "No Teacher")
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <span class="class-badge badge-success">
                                    <i class="fas fa-users me-1"></i>@classItem.StudentsCount Active
                                </span>
                                <span class="class-badge badge-info">
                                    <i class="fas fa-user-graduate me-1"></i>@classItem.TotalStudents Total
                                </span>
                            </div>
                        </div>

                        <!-- ACTIONS -->
                        <div class="card-actions">
                            <a asp-action="Details" asp-route-id="@classItem.Id" class="btn-action btn-details">
                                <i class="fas fa-eye me-1"></i> Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@classItem.Id" class="btn-action btn-edit">
                                <i class="fas fa-edit me-1"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@classItem.Id" method="post" 
                                  class="d-inline" style="flex:1;" 
                                  onsubmit="return confirmDelete('@(classItem.Name + " - " + classItem.Section)')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-action btn-delete w-100 h-100 p-2 border-0">
                                    <i class="fas fa-trash me-1"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        // 🔍 البحث بالاسم + الـ Section
        document.getElementById('searchInput').addEventListener('keyup', function() {
            const value = this.value.toLowerCase().trim();
            document.querySelectorAll('.class-item').forEach(item => {
                const name = item.dataset.name;
                item.style.display = name.includes(value) ? '' : 'none';
            });
        });

        // Delete confirmation
        function confirmDelete(className) {
            return confirm(`⚠️ Delete "${className || 'Class'}"?\n\nThis action cannot be undone!`);
        }

        // Animate cards on load
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.class-card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(30px)';
                setTimeout(() => {
                    card.style.transition = 'all 0.6s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
}
