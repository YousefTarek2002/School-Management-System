@model SchoolSystem.Models.VM.AddClassVM
@{
    ViewData["Title"] = "Edit Class";
}

<style>
    /* ===== MAIN CARD ===== */
    .form-card-modern {
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        overflow: hidden;
        border: none;
        max-width: 600px;
        margin: 40px auto;
    }

    /* ===== HEADER ===== */
    .form-header-modern {
        background: linear-gradient(135deg, #198754 0%, #157347 100%);
        color: white;
        padding: 35px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .form-header-icon-modern {
        width: 75px;
        height: 75px;
        background: rgba(255,255,255,0.25);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        margin: 0 auto 15px;
        backdrop-filter: blur(12px);
    }

    /* ===== INPUT GROUP ===== */
    .input-group-modern {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
        background: white;
        margin-bottom: 25px;
    }

        .input-group-modern:focus-within {
            border-color: #198754;
            box-shadow: 0 10px 30px rgba(25,135,84,0.25);
            transform: translateY(-2px);
        }

    .input-group-text-modern {
        background: linear-gradient(135deg, #d1e7dd, #badbcc);
        border: none;
        color: #198754;
        font-weight: 600;
        padding: 15px 20px;
        display: flex;
        align-items: center;
    }

    .form-control-modern {
        border: none;
        padding: 15px 20px;
        font-size: 16px;
        background: transparent;
        box-shadow: none;
    }

        .form-control-modern:focus {
            box-shadow: none;
            background: #f8fffb;
        }

    /* ===== LABELS ===== */
    .label-modern {
        font-weight: 700;
        color: #2c3e50;
        font-size: 15px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ===== BUTTONS ===== */
    .btn-modern {
        padding: 14px 35px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 16px;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(25,135,84,0.3);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-success-modern {
        background: linear-gradient(135deg, #198754, #157347);
        color: white;
    }

    .btn-secondary-modern {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        color: #6c757d;
        border: 1px solid #e3e6f0;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .btn-modern:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(25,135,84,0.4);
        color: white !important;
    }

    /* ===== ALERTS ===== */
    .alert-modern {
        border-radius: 12px;
        padding: 15px 20px;
        margin-bottom: 25px;
        border: none;
        font-weight: 500;
    }

    .btn-group-custom {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 20px;
    }
</style>

<div class="content container-fluid">
    <!-- PAGE HEADER -->
    <div class="row mb-5 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1" style="color: #2c3e50;">
                <i class="fas fa-edit me-2 text-success"></i>
                Edit Class
            </h2>
            <p class="mb-0 text-muted fs-6">Update class information</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary-modern btn-lg px-4">
                <i class="fas fa-arrow-left me-1"></i>Back to Classes
            </a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-modern shadow-sm mx-auto" style="max-width: 600px;">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["success"]
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-modern shadow-sm mx-auto" style="max-width: 600px;">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["error"]
        </div>
    }

    <!-- FORM CARD -->
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card form-card-modern shadow-lg">
                <div class="form-header-modern">
                    <div class="form-header-icon-modern">
                        <i class="fas fa-edit text-white"></i>
                    </div>
                    <h4 class="mb-1 fw-bold">Update Class</h4>
                    <p class="mb-0 opacity-90">Update class information below</p>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-modern mb-5 shadow-sm">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            Please fix the following errors:
                        </div>

                        <!-- CLASS NAME -->
                        <div class="mb-4">
                            <label asp-for="Name" class="label-modern">
                                <i class="fas fa-tag text-primary"></i>
                                Class Name <span class="text-danger">*</span>
                            </label>
                            <div class="input-group-modern">
                                <span class="input-group-text-modern">
                                    <i class="fas fa-tag"></i>
                                </span>
                                <input asp-for="Name" class="form-control-modern" placeholder="Enter class name (e.g. Grade 10A)..." />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small d-block mt-2"></span>
                        </div>

                        <!-- SECTION -->
                        <div class="mb-4">
                            <label asp-for="Section" class="label-modern">
                                <i class="fas fa-layer-group text-info"></i>
                                Section
                            </label>
                            <div class="input-group-modern">
                                <span class="input-group-text-modern">
                                    <i class="fas fa-layer-group"></i>
                                </span>
                                <input asp-for="Section" class="form-control-modern" placeholder="Enter section (e.g. A, B, C)..." />
                            </div>
                            <span asp-validation-for="Section" class="text-danger small d-block mt-2"></span>
                        </div>

                        <!-- TEACHER SELECT -->
                        <div class="mb-5">
                            <label asp-for="TeacherId" class="label-modern">
                                <i class="fas fa-chalkboard-teacher text-warning"></i>
                                Class Teacher <span class="text-danger">*</span>
                            </label>
                            <div class="input-group-modern">
                                <span class="input-group-text-modern">
                                    <i class="fas fa-chalkboard-teacher"></i>
                                </span>
                                <select asp-for="TeacherId" class="form-control-modern form-select" asp-items="@(new SelectList(ViewBag.Teachers, "Id", "Name", Model.TeacherId))">
                                    <option value="">-- Select Teacher --</option>
                                </select>
                            </div>
                            <span asp-validation-for="TeacherId" class="text-danger small d-block mt-2"></span>
                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="btn-group-custom">
                            <button type="submit" class="btn btn-success-modern btn-lg px-5 shadow-sm">
                                <i class="fas fa-save me-1"></i>Update Class
                            </button>
                            <a asp-action="Index" class="btn btn-secondary-modern btn-lg px-5 shadow-sm">
                                <i class="fas fa-arrow-left me-1"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
