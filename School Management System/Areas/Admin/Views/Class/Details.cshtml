@model School.Models.Class
@{
    ViewData["Title"] = "Class Details";
    var allStudents = ViewBag.AllStudents as List<School.Models.Student>;
}

<style>
    .page-container {
        padding: 30px 0;
    }

    .header-card {
        background: linear-gradient(135deg, #00c6ff, #0072ff);
        color: white;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .modern-card {
        background: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        margin-bottom: 20px;
    }

    .student-card {
        border-radius: 12px;
        padding: 15px;
        background: #f8f9fa;
        transition: 0.3s;
    }

    .student-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .btn-modern {
        border-radius: 25px;
        padding: 8px 18px;
        font-weight: 600;
    }

    .select-modern {
        border-radius: 10px;
    }
</style>

<div class="container page-container">

    <!-- HEADER -->
    <div class="header-card">
        <h3 class="mb-2">
            <i class="fas fa-school me-2"></i>
            @Model.Name - @Model.Section
        </h3>
        <p class="mb-0">
            <strong>Teacher:</strong> @(Model.Teacher?.Name ?? "No Teacher")
        </p>
    </div>

    <!-- ADD STUDENT -->
    <div class="modern-card">
        <h5 class="mb-3">
            <i class="fas fa-user-plus me-2 text-primary"></i>
            Add Student
        </h5>

        <form asp-action="AddStudentToClass" method="post" class="row g-2">
            @Html.AntiForgeryToken()

            <input type="hidden" name="ClassId" value="@Model.Id" />

            <div class="col-md-8">
                <select name="StudentId" class="form-select select-modern">
                    <option value="">-- Select Student --</option>
                    @foreach (var student in allStudents)
                    {
                        <option value="@student.Id">@student.FirstName</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <button type="submit" class="btn btn-primary btn-modern w-100">
                    <i class="fas fa-plus me-1"></i> Add
                </button>
            </div>
        </form>
    </div>

    <!-- STUDENTS LIST -->
    <div class="modern-card">
        <h5 class="mb-3">
            <i class="fas fa-users me-2 text-success"></i>
            Students
        </h5>

        <div class="row">
            @if (Model.ClassEnrollments.Any())
            {
                @foreach (var enrollment in Model.ClassEnrollments)
                {
                    <div class="col-md-4 mb-3">
                        <div class="student-card">

                            <h6 class="fw-bold mb-2">
                                @enrollment.Student?.FirstName
                            </h6>

                            <p class="mb-2">
                                Status:
                                <span class="badge @(enrollment.Status ? "bg-success" : "bg-secondary")">
                                    @(enrollment.Status ? "Active" : "Inactive")
                                </span>
                            </p>

                            <form asp-action="RemoveStudent" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="id" value="@enrollment.Id" />
                                <input type="hidden" name="classId" value="@Model.Id" />

                                <button type="submit" class="btn btn-danger btn-sm btn-modern w-100">
                                    <i class="fas fa-trash me-1"></i> Remove
                                </button>
                            </form>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="fas fa-user-slash fa-2x mb-2"></i>
                    <p>No students in this class</p>
                </div>
            }
        </div>
    </div>

    <!-- BACK BUTTON -->
    <div class="text-center">
        <a asp-action="Index" class="btn btn-secondary btn-modern">
            <i class="fas fa-arrow-left me-1"></i> Back to Classes
        </a>
    </div>

</div>