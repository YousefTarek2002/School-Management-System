@model School.Models.Class
@{
    ViewData["Title"] = "Class Details";
    var allStudents = ViewBag.AllStudents as List<School.Models.Student>;
}

<div class="container mt-4">
    <h3>
        <i class="fas fa-school me-2 text-primary"></i>
        @Model.Name - @Model.Section
    </h3>
    <div class="mb-3">
        <strong>Teacher:</strong> @Model.Teacher?.Name ?? "No Teacher"
    </div>

    <hr />

    <!-- ADD STUDENT -->
    <div class="card mb-4 p-3 shadow-sm">
        <h5>Add Student</h5>
        <form asp-action="AddStudentToClass" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ClassId" value="@Model.Id" />
            <select name="StudentId" class="form-select">
                <option value="">-- Select Student --</option>
                @foreach (var student in allStudents)
                {
                    <option value="@student.Id">@student.FirstName</option>
                }
            </select>
            <button type="submit" class="btn btn-primary"><i class="fas fa-plus me-1"></i> Add</button>
        </form>
    </div>

    <!-- STUDENTS LIST -->
    <div class="row">
        @foreach (var enrollment in Model.ClassEnrollments)
        {
            <div class="col-md-4 mb-3">
                <div class="card p-3 shadow-sm">
                    <h6>@enrollment.Student?.FirstName</h6>
                    <p>Status: @(enrollment.Status ? "Active" : "Inactive")</p>
                    <form asp-action="RemoveStudent" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@enrollment.Id" />
                        <input type="hidden" name="classId" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash me-1"></i> Remove
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <a asp-action="Index" class="btn btn-secondary mt-3">
        <i class="fas fa-arrow-left me-1"></i> Back to Classes
    </a>
</div>