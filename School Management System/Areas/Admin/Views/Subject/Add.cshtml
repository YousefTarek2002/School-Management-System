@model SubjectVM
@{
    ViewData["Title"] = "Add New Subject";
}

<style>
    .form-card {
        border: none;
        border-radius: 25px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 20px 50px rgba(0,0,0,0.12);
        overflow: hidden;
        height: 100%;
    }
    .form-header {
        background: linear-gradient(135deg, #ff6b6b, #feca57);
        color: white;
        padding: 35px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .form-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
        animation: float 6s ease-in-out infinite;
    }
    .form-icon {
        width: 90px;
        height: 90px;
        background: rgba(255,255,255,0.25);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin: 0 auto 20px;
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    .input-group-modern {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
        background: white;
        height: 65px;
    }
    .input-group-modern:focus-within {
        border-color: #ff6b6b;
        box-shadow: 0 0 0 0.3rem rgba(255,107,107,0.15), 0 10px 25px rgba(255,107,107,0.2);
        transform: translateY(-2px);
    }
    .input-group-text-modern {
        background: linear-gradient(135deg, #fff5f5, #ffeaea);
        border: none;
        color: #ff6b6b;
        font-weight: 600;
        display: flex;
        align-items: center;
        padding: 0 20px;
        height: 100%;
    }
    .form-control-modern {
        border: none;
        padding: 20px;
        font-size: 16px;
        background: transparent;
        height: 100%;
        box-shadow: none;
    }
    .form-control-modern:focus {
        box-shadow: none;
        background: #fdf2f2;
    }
    .select-modern {
        border: none;
        padding: 20px;
        font-size: 16px;
        background: transparent;
        height: 100%;
        width: 100%;
    }
    .teachers-container {
        background: white;
        border-radius: 15px;
        border: 2px solid #e9ecef;
        min-height: 120px;
        transition: all 0.3s ease;
        padding: 15px;
        position: relative;
    }
    .teachers-container:focus-within {
        border-color: #ff6b6b;
        box-shadow: 0 0 0 0.3rem rgba(255,107,107,0.15);
        transform: translateY(-2px);
    }
    .teachers-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
        min-height: 40px;
    }
    .teacher-tag {
        background: linear-gradient(135deg, #ff6b6b, #feca57);
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .teacher-tag .remove-tag {
        background: rgba(255,255,255,0.3);
        border: none;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        cursor: pointer;
        margin-left: 8px;
    }
    .btn-modern {
        padding: 15px 40px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 16px;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(255,107,107,0.4);
        position: relative;
        overflow: hidden;
    }
    .btn-primary-modern { background: linear-gradient(135deg, #ff6b6b, #feca57); color: white; }
    .btn-secondary-modern { 
        background: linear-gradient(135deg, #f8f9fa, #e9ecef); 
        color: #6c757d; 
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .btn-modern:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(255,107,107,0.5);
        color: white !important;
    }
    .label-modern {
        font-weight: 700;
        color: #2c3e50;
        font-size: 15px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
   
</style>

<div class="content container-fluid">
    <!-- PAGE HEADER -->
    <div class="row mb-5 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-2" style="color: #2c3e50;">
                <i class="fas fa-book-open me-3 text-warning"></i>
                Add New Subject
            </h2>
            <p class="mb-0 text-muted lead">Create a new subject and assign teachers</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary-modern btn-lg shadow-lg px-5">
                <i class="fas fa-arrow-left me-2"></i>Back to Subjects
            </a>
        </div>
    </div>

    <!-- FORM CARD -->
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card form-card shadow-xl">
                <!-- HEADER -->
                <div class="form-header">
                    <div class="form-icon">
                        <i class="fas fa-book-open"></i>
                    </div>
                    <h3 class="mb-2 fw-bold fs-2 position-relative">Subject Information</h3>
                    <p class="mb-0 opacity-90 position-relative">Create new subject and assign qualified teachers</p>
                </div>

                <!-- FORM BODY -->
                <div class="card-body p-5">
                    <form asp-action="Add" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-4 rounded-3">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            Please fix the following errors:
                        </div>

                        <!-- SUBJECT NAME -->
                        <div class="mb-5">
                            <label class="label-modern">
                                <i class="fas fa-heading text-primary"></i>
                                Subject Name
                            </label>
                            <div class="input-group-modern">
                                <span class="input-group-text-modern">
                                    <i class="fas fa-bookmark"></i>
                                </span>
                                <input asp-for="Name" class="form-control-modern" placeholder="e.g. Mathematics, Physics, Chemistry..." />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small d-block mt-2"></span>
                        </div>

                        <!-- TEACHERS ASSIGNMENT -->
                        <div class="mb-5">
                            <label class="label-modern">
                                <i class="fas fa-users text-success"></i>
                                Assign Teachers <span class="text-muted fs-6">(Optional)</span>
                            </label>
                            <div class="teachers-container">
                                <div class="teachers-tags" id="teachersTags">
                                    <!-- Selected teachers will appear here -->
                                </div>
                                <select asp-for="SelectedTeachers" id="teachersSelect" class="select-modern" multiple style="display: none;">
                                    @if (Model.AllTeachers != null)
                                    {
                                        @foreach (var teacher in Model.AllTeachers)
                                        {
                                            <option value="@teacher.Id">@teacher.Name</option>
                                        }
                                    }
                                </select>
                                <div class="position-absolute end-0 top-50 translate-middle-y pe-3" style="z-index: 10;">
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="toggleTeachersSelect()">
                                        <i class="fas fa-plus" id="teachersToggleIcon"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="form-text mt-2">
                                <i class="fas fa-info-circle me-1 text-info"></i>
                                Click the + button to select teachers for this subject (multiple selection supported)
                            </div>
                            <span asp-validation-for="SelectedTeachers" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="text-center mt-5 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-secondary-modern btn-lg me-3 px-5 shadow-lg">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary-modern btn-lg px-5 shadow-lg">
                                <i class="fas fa-plus me-2"></i>
                                Create Subject
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let teachersSelect = document.getElementById('teachersSelect');
        let teachersTags = document.getElementById('teachersTags');
        let toggleIcon = document.getElementById('teachersToggleIcon');

        // Toggle teachers selection
        function toggleTeachersSelect() {
            if (teachersSelect.style.display === 'none' || teachersSelect.style.display === '') {
                teachersSelect.style.display = 'block';
                teachersSelect.focus();
                toggleIcon.classList.remove('fa-plus');
                toggleIcon.classList.add('fa-times');
            } else {
                teachersSelect.style.display = 'none';
                toggleIcon.classList.remove('fa-times');
                toggleIcon.classList.add('fa-plus');
            }
        }

        // Handle teacher selection
        teachersSelect.addEventListener('change', function() {
            updateTeachersTags();
        });

        function updateTeachersTags() {
            teachersTags.innerHTML = '';
            const selectedOptions = Array.from(teachersSelect.selectedOptions);
            
            selectedOptions.forEach(option => {
                const tag = document.createElement('div');
                tag.className = 'teacher-tag';
                tag.innerHTML = `
                    <i class="fas fa-user-tie"></i>
                    ${option.text}
                    <button type="button" class="remove-tag" onclick="removeTeacher(${option.value})">&times;</button>
                `;
                teachersTags.appendChild(tag);
            });
        }

        function removeTeacher(teacherId) {
            const options = teachersSelect.options;
            for (let i = 0; i < options.length; i++) {
                if (options[i].value == teacherId) {
                    options[i].selected = false;
                    break;
                }
            }
            updateTeachersTags();
        }

        // Close select when clicking outside
        document.addEventListener('click', function(event) {
            const teachersContainer = document.querySelector('.teachers-container');
            const select = document.getElementById('teachersSelect');
            
            if (!teachersContainer.contains(event.target)) {
                select.style.display = 'none';
                toggleIcon.classList.remove('fa-times');
                toggleIcon.classList.add('fa-plus');
            }
        });

        // Form animations
        document.addEventListener('DOMContentLoaded', function() {
            const inputs = document.querySelectorAll('.form-control-modern');
            inputs.forEach(input => {
                input.addEventListener('focus', function() {
                    this.parentElement.style.transform = 'scale(1.02)';
                });
                input.addEventListener('blur', function() {
                    this.parentElement.style.transform = 'scale(1)';
                });
            });
        });
    </script>
}
