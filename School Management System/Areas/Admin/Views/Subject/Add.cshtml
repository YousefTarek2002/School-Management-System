@model SubjectVM
@{
    ViewData["Title"] = "Add Subject";
}

<style>
    /* ===== MAIN CARD ===== */
    .form-card-modern {
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        overflow: hidden;
        border: none;
    }

    /* ===== HEADER ===== */
    .form-header-modern {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .form-header-icon-modern {
        width: 75px;
        height: 75px;
        background: rgba(255,255,255,0.25);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        margin: 0 auto 15px;
        backdrop-filter: blur(12px);
    }

    /* ===== INPUT GROUP ===== */
    .input-group-modern {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
        background: white;
        margin-bottom: 25px;
    }

        .input-group-modern:focus-within {
            border-color: #28a745;
            box-shadow: 0 10px 30px rgba(40,167,69,0.25);
            transform: translateY(-2px);
        }

    .input-group-text-modern {
        background: linear-gradient(135deg, #f0fff4, #e8f5e8);
        border: none;
        color: #28a745;
        font-weight: 600;
        padding: 15px 20px;
        display: flex;
        align-items: center;
    }

    .form-control-modern {
        border: none;
        padding: 15px 20px;
        font-size: 16px;
        background: transparent;
        box-shadow: none;
    }

        .form-control-modern:focus {
            box-shadow: none;
            background: #f8fff8;
        }

    /* ===== LABELS ===== */
    .label-modern {
        font-weight: 700;
        color: #2c3e50;
        font-size: 15px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ===== TEACHER CARDS ===== */
    .teacher-card-modern {
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 18px 20px;
        cursor: pointer;
        transition: all 0.3s ease;
        background: #f8f9fa;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .teacher-card-modern:hover {
            border-color: #28a745;
            background: linear-gradient(135deg, #f0fff4, #e8f5e8);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(40,167,69,0.15);
        }

        .teacher-card-modern.active {
            border-color: #28a745;
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
            box-shadow: 0 12px 35px rgba(40,167,69,0.3);
        }

        .teacher-card-modern input {
            transform: scale(1.3);
            accent-color: #28a745;
        }

    /* ===== BUTTONS ===== */
    .btn-modern {
        padding: 12px 35px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 15px;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(40,167,69,0.3);
    }

    .btn-primary-modern {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
    }

    .btn-secondary-modern {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        color: #6c757d;
        border: 1px solid #e3e6f0;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .btn-modern:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(40,167,69,0.4);
        color: white !important;
    }

    /* ===== ACTION BUTTONS ===== */
    .action-buttons-modern {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        border-radius: 12px;
        padding: 12px 20px;
        margin-bottom: 25px;
        display: flex;
        gap: 10px;
        border: 1px solid #e3e6f0;
    }

    /* ===== ALERTS ===== */
    .alert-modern {
        border-radius: 12px;
        padding: 15px 20px;
        margin-bottom: 25px;
        border: none;
        font-weight: 500;
    }

    
</style>

<div class="content container-fluid">
    <!-- PAGE HEADER -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1" style="color: #2c3e50;">
                <i class="fas fa-book me-2 text-success"></i>
                Add New Subject
            </h2>
            <p class="mb-0 text-muted">Create subject and assign teachers</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary-modern btn-lg px-4">
                <i class="fas fa-arrow-left me-1"></i>Back to Subjects
            </a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-modern shadow-sm">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["success"]
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-modern shadow-sm">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["error"]
        </div>
    }

    <!-- FORM CARD -->
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-11">
            <div class="card form-card-modern shadow-lg">
                <div class="form-header-modern">
                    <div class="form-header-icon-modern">
                        <i class="fas fa-book-open text-white"></i>
                    </div>
                    <h4 class="mb-1 fw-bold">Subject Information</h4>
                    <p class="mb-0 opacity-90">Enter subject name and assign teachers</p>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Add" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-modern mb-4 shadow-sm">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            Please fix the following errors:
                        </div>

                        <!-- SUBJECT NAME -->
                        <div class="mb-5">
                            <label class="label-modern">
                                <i class="fas fa-book text-success"></i>
                                Subject Name <span class="text-danger">*</span>
                            </label>
                            <div class="input-group-modern">
                                <span class="input-group-text-modern">
                                    <i class="fas fa-book"></i>
                                </span>
                                <input asp-for="Name" class="form-control-modern" placeholder="Enter subject name (e.g. Mathematics)" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small d-block mt-2"></span>
                        </div>

                        <!-- TEACHERS ASSIGNMENT -->
                        <div class="mb-5">
                            <label class="label-modern">
                                <i class="fas fa-users text-info"></i>
                                Assign Teachers <span class="text-muted fs-6">(Select one or more)</span>
                            </label>

                            <div class="action-buttons-modern mb-4 p-3">
                                <button type="button" class="btn btn-sm btn-outline-success" onclick="selectAll()">
                                    <i class="fas fa-check-double me-1"></i>Select All
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearAll()">
                                    <i class="fas fa-times me-1"></i>Clear
                                </button>
                            </div>

                            <div class="row" style="max-height: 400px; overflow-y: auto;">
                                @foreach (var teacher in Model.AllTeachers)
                                {
                                    <div class="col-md-4 col-sm-6">
                                        <label class="teacher-card-modern w-100">
                                            <input type="checkbox" name="SelectedTeachers" value="@teacher.Id" />
                                            <span>@teacher.Name</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="text-center pt-4 border-top">
                            <a asp-action="Index" class="btn btn-secondary-modern btn-lg me-3 px-5 shadow-sm">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary-modern btn-lg px-5 shadow-sm">
                                <i class="fas fa-save me-2"></i>Create Subject
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function selectAll() {
            document.querySelectorAll("input[name='SelectedTeachers']")
                .forEach(x => {
                    x.checked = true;
                    x.parentElement.classList.add('active');
                });
        }

        function clearAll() {
            document.querySelectorAll("input[name='SelectedTeachers']")
                .forEach(x => {
                    x.checked = false;
                    x.parentElement.classList.remove('active');
                });
        }

        // Enhanced UI interaction
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll(".teacher-card-modern").forEach(card => {
                card.addEventListener("click", function (e) {
                    if (e.target.type !== 'checkbox') {
                        const checkbox = this.querySelector('input[type="checkbox"]');
                        checkbox.checked = !checkbox.checked;
                        this.classList.toggle('active', checkbox.checked);
                    }
                });
            });

            // Scroll to top on load
            window.scrollTo(0, 0);
        });
    </script>
}
