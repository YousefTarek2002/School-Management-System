@using School.Models.VM
@model IEnumerable<SubjectVM>

<style>
    .subject-card {
        border: none;
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        transition: all 0.4s ease;
        height: 100%;
        overflow: hidden;
    }

        .subject-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }

    .subject-avatar {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        font-size: 30px;
        font-weight: 700;
        border-radius: 50%;
        margin: 25px auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }

    .subject-name {
        font-size: 22px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 15px;
        line-height: 1.3;
    }

        .subject-name a {
            color: inherit;
            text-decoration: none;
        }

            .subject-name a:hover {
                color: #667eea;
            }

    .subject-badge {
        padding: 8px 16px;
        margin: 4px;
        border-radius: 25px;
        font-size: 13px;
        font-weight: 600;
        display: inline-block;
    }

    .badge-success {
        background: linear-gradient(45deg, #28a745, #20c997);
        color: white;
    }

    .badge-info {
        background: linear-gradient(45deg, #17a2b8, #138496);
        color: white;
    }

    .badge-secondary {
        background: linear-gradient(45deg, #6c757d, #5a6268);
        color: white;
    }

    .teachers-overflow {
        background: linear-gradient(45deg, #17a2b8, #138496);
        color: white !important;
        font-size: 12px;
        padding: 6px 12px;
    }

    .stats-row {
        margin: 20px 0;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 12px;
    }

    .card-actions {
        padding: 20px;
        border-top: 1px solid #eee;
        background: #fafbfc;
        display: flex;
        gap: 8px;
        justify-content: center;
    }

    .btn-action {
        flex: 1;
        padding: 10px 15px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        border: none;
        transition: all 0.3s ease;
    }

    .btn-edit {
        background: linear-gradient(45deg, #28a745, #20c997);
        color: white;
    }

    .btn-delete {
        background: linear-gradient(45deg, #dc3545, #c82333);
        color: white;
    }

    .btn-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        color: white !important;
    }
</style>

<form method="post">
    @Html.AntiForgeryToken()
</form>

<div class="content container-fluid">

    <!-- HEADER -->

    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h4>
                    Subjects <span class="badge bg-primary">@Model.Count()</span>
                </h4>
            </div>
            <div class="col-md-6 text-end">
                <div class="d-flex gap-2 justify-content-end">

                    <form method="get" class="d-flex gap-2">
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control" style="width:250px;"
                               placeholder="Search...">
                        <button class="btn btn-primary">Search</button>
                    </form>

                    <a asp-action="Add" class="btn btn-primary">Add</a>
                </div>
            </div>
        </div>

    </div>

    <!-- GRID -->
    <div class="row mt-4" id="subjectGrid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="empty-state">
                    <i class="fas fa-book fa-5x text-muted mb-4 opacity-75"></i>
                    <h3 class="text-muted mb-3">No Subjects Yet</h3>
                    <p class="lead text-muted mb-4">Get started by adding your first subject</p>
                    <a asp-action="Add" class="btn btn-primary btn-lg shadow-lg px-5">
                        <i class="fas fa-plus me-3"></i> Add First Subject
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var subject in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-4 subject-item" data-name="@(subject.Name ?? "").ToLower()">

                    <div class="card subject-card h-100">
                        <!-- AVATAR & NAME -->
                        <div class="text-center pt-4">
                            <div class="subject-avatar">
                                @(subject.Name?.Length > 0 ? subject.Name[0].ToString().ToUpper() : "S")
                            </div>
                            <h5 class="subject-name">
                                <a asp-action="Edit" asp-route-id="@subject.Id">@(subject.Name ?? "Unnamed")</a>
                            </h5>
                        </div>

                        <!-- TEACHERS -->
                        <div class="px-4 pb-3">
                            @if (subject.TeacherNames?.Any() == true)
                            {
                                @foreach (var teacher in subject.TeacherNames.Take(2))
                                {
                                    <span class="subject-badge badge-success d-block mb-1">
                                        <i class="fas fa-user-tie me-1"></i>@(teacher ?? "")
                                    </span>
                                }
                                @if (subject.TeacherNames.Count > 2)
                                {
                                    <span class="subject-badge teachers-overflow">
                                        +@(subject.TeacherNames.Count - 2) more
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="subject-badge badge-secondary">
                                    <i class="fas fa-user-slash me-1"></i> No teachers
                                </span>
                            }
                        </div>

                        <!-- STATS -->
                        <div class="stats-row">
                            <div class="row text-center g-3">
                                <div class="col-6">
                                    <div class="small text-muted">Teachers</div>
                                    <strong class="text-primary fs-5">@(subject.TeacherNames?.Count ?? 0)</strong>
                                </div>
                                <div class="col-6">
                                    <div class="small text-muted">Students</div>
                                    <strong class="text-success fs-5">0</strong>
                                </div>
                            </div>
                        </div>

                        <!-- ACTIONS --> 
                            
                        <div class="card-actions">
                            <a asp-action="Edit" asp-route-id="@subject.Id" class="btn-action btn-edit">
                                <i class="fas fa-edit me-1"></i> Edit
                            </a>

                            <button onclick="deleteSubject(@subject.Id, '@subject.Name')" class="btn-action btn-delete">
                                <i class="fas fa-trash me-1"></i> Delete
                            </button>ئ
                        </div>
                             
                    </div>
                </div>
            }
        }
    </div>

    <!-- PAGINATION -->
    @if (ViewBag.TotalPages > 1)
    {
        <ul class="pagination justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? " disabled" : "")">
                <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)&search=@ViewBag.Search">Prev</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? " active" : "")">
                    <a class="page-link" href="?page=@i&search=@ViewBag.Search">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? " disabled" : "")">
                <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)&search=@ViewBag.Search">Next</a>
            </li>

        </ul>
    }

</div>

@section Scripts {


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function deleteSubject(id, name) {

        Swal.fire({
        title: `Delete "${name}"?`,
        text: "This action cannot be undone!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#dc3545",
        confirmButtonText: "Yes, delete",
        cancelButtonText: "Cancel"
        }).then((result) => {

        if (result.isConfirmed) {

        fetch(`/Admin/Subject/Delete/${id}`, {
        method: 'POST',
        headers: {
        'RequestVerificationToken':
        document.querySelector('input[name="__RequestVerificationToken"]').value
        }
        })
        .then(res => res.json())
        .then(data => {

        if (data.success) {

        Swal.fire({
        icon: "success",
        title: "Deleted!",
        timer: 1200,
        showConfirmButton: false
        });

        setTimeout(() => location.reload(), 1200);

        } else {
        Swal.fire("Error", data.message, "error");
        }

        });
        }
        });
        }
    </script>

}
