@model School.Models.VM.FeeVM
@{
    ViewData["Title"] = "Edit Fee";
}

<style>
    /* ===== MAIN CARD ===== */
    .form-card-modern {
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        overflow: hidden;
        border: none;
    }

    /* ===== HEADER ===== */
    .form-header-modern {
        background: linear-gradient(135deg, #fd7e14 0%, #f53939 100%);
        color: white;
        padding: 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .form-header-icon-modern {
        width: 75px;
        height: 75px;
        background: rgba(255,255,255,0.25);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        margin: 0 auto 15px;
        backdrop-filter: blur(12px);
    }

    /* ===== INPUT GROUP ===== */
    .input-group-modern {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
        background: white;
        margin-bottom: 25px;
    }

        .input-group-modern:focus-within {
            border-color: #fd7e14;
            box-shadow: 0 10px 30px rgba(253,126,20,0.25);
            transform: translateY(-2px);
        }

    .input-group-text-modern {
        background: linear-gradient(135deg, #fff3e0, #ffe0b2);
        border: none;
        color: #fd7e14;
        font-weight: 600;
        padding: 15px 20px;
        display: flex;
        align-items: center;
    }

    .form-control-modern {
        border: none;
        padding: 15px 20px;
        font-size: 16px;
        background: transparent;
        box-shadow: none;
    }

        .form-control-modern:focus {
            box-shadow: none;
            background: #fff8e1;
        }

    /* ===== LABELS ===== */
    .label-modern {
        font-weight: 700;
        color: #2c3e50;
        font-size: 15px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ===== CHECKBOX ===== */
    .form-check-modern {
        background: linear-gradient(135deg, #fff3e0, #ffe0b2);
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 18px 20px;
        margin-bottom: 25px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .form-check-modern:hover {
            border-color: #fd7e14;
            box-shadow: 0 8px 25px rgba(253,126,20,0.15);
        }

        .form-check-modern input:checked + .form-check-label-modern {
            color: #fd7e14;
            font-weight: 700;
        }

    .form-check-input-modern {
        transform: scale(1.4);
        accent-color: #fd7e14;
        margin-right: 12px;
    }

    /* ===== BUTTONS ===== */
    .btn-modern {
        padding: 14px 40px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 16px;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(253,126,20,0.3);
    }

    .btn-primary-modern {
        background: linear-gradient(135deg, #fd7e14, #f53939);
        color: white;
    }

    .btn-secondary-modern {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        color: #6c757d;
        border: 1px solid #e3e6f0;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .btn-modern:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(253,126,20,0.4);
        color: white !important;
    }

    /* ===== ALERTS ===== */
    .alert-modern {
        border-radius: 12px;
        padding: 15px 20px;
        margin-bottom: 25px;
        border: none;
        font-weight: 500;
    }
</style>

<div class="content container-fluid">
    <!-- PAGE HEADER -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1" style="color: #2c3e50;">
                <i class="fas fa-edit me-2 text-warning"></i>
                Edit Fee
            </h2>
            <p class="mb-0 text-muted">Update fee payment information</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary-modern btn-lg px-4">
                <i class="fas fa-arrow-left me-1"></i>Back to Fees
            </a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-modern shadow-sm">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["success"]
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-modern shadow-sm">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["error"]
        </div>
    }

    <!-- FORM CARD -->
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card form-card-modern shadow-lg">
                <div class="form-header-modern">
                    <div class="form-header-icon-modern">
                        <i class="fas fa-edit text-white"></i>
                    </div>
                    <h4 class="mb-1 fw-bold">Update Fee</h4>
                    <p class="mb-0 opacity-90">Modify fee payment details</p>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-modern mb-5 shadow-sm">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            Please fix the following errors:
                        </div>

                        <!-- STUDENT SELECT -->
                        <div class="mb-5">
                            <label class="label-modern">
                                <i class="fas fa-user-graduate text-warning"></i>
                                Student <span class="text-danger">*</span>
                            </label>
                            <div class="input-group-modern">
                                <span class="input-group-text-modern">
                                    <i class="fas fa-user-graduate"></i>
                                </span>
                                <select asp-for="StudentId" class="form-control-modern form-select" asp-items="Model.Students">
                                    <option value="">Select a student</option>
                                </select>
                            </div>
                            <span asp-validation-for="StudentId" class="text-danger small d-block mt-2"></span>
                        </div>

                        <!-- AMOUNT -->
                        <div class="mb-5">
                            <label class="label-modern">
                                <i class="fas fa-money-bill-wave text-success"></i>
                                Amount (EGP) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group-modern">
                                <span class="input-group-text-modern">
                                    <i class="fas fa-egyptian-pound"></i>
                                </span>
                                <input asp-for="Amount" class="form-control-modern" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small d-block mt-2"></span>
                        </div>

                        <!-- DUE DATE -->
                        <div class="mb-5">
                            <label class="label-modern">
                                <i class="fas fa-calendar-alt text-info"></i>
                                Due Date <span class="text-danger">*</span>
                            </label>
                            <div class="input-group-modern">
                                <span class="input-group-text-modern">
                                    <i class="fas fa-calendar-alt"></i>
                                </span>
                                <input asp-for="DueDate" type="date" class="form-control-modern" />
                            </div>
                            <span asp-validation-for="DueDate" class="text-danger small d-block mt-2"></span>
                        </div>

                        <!-- PAID CHECKBOX -->
                        <div class="mb-5">
                            <label class="form-check-modern" style="cursor: pointer;">
                                <input asp-for="Paid" class="form-check-input-modern" />
                                <span class="form-check-label-modern ms-3">
                                    <i class="fas fa-check-circle text-success me-2"></i>
                                    Mark as Paid
                                </span>
                            </label>
                            <small class="text-muted d-block mt-1">
                                Check if the fee has been paid
                            </small>
                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="text-center pt-4 border-top">
                            <a asp-action="Index" class="btn btn-secondary-modern btn-lg me-3 px-5 shadow-sm">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary-modern btn-lg px-5 shadow-sm">
                                <i class="fas fa-save me-2"></i>Update Fee
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
