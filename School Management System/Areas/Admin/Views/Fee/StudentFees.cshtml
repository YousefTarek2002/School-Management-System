@model School.Models.VM.StudentFeesVM
@{
    ViewData["Title"] = "Student Fees";
}

<style>
    /* ===== MAIN CARD ===== */
    .dashboard-card {
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        overflow: hidden;
        border: none;
    }

    /* ===== HEADER ===== */
    .dashboard-header {
        background: linear-gradient(135deg, #fd7e14 0%, #f53939 100%);
        color: white;
        padding: 30px;
        text-align: center;
        position: relative;
    }

    .dashboard-icon {
        width: 80px;
        height: 80px;
        background: rgba(255,255,255,0.25);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin: 0 auto 20px;
        backdrop-filter: blur(12px);
    }

    /* ===== TOTALS CARDS ===== */
    .total-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 16px;
        padding: 25px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(102,126,234,0.3);
        transition: all 0.3s ease;
    }

    .total-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(102,126,234,0.4);
    }

    .total-number {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 8px;
    }

    /* ===== TABLE ===== */
    .fees-table {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .table-modern {
        margin: 0;
        border-radius: 0;
    }

    .table-modern thead th {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        border: none;
        font-weight: 700;
        color: #2c3e50;
        padding: 20px 15px;
        font-size: 15px;
        border-bottom: 3px solid #dee2e6;
    }

    .table-modern tbody td {
        padding: 18px 15px;
        border-color: #f1f3f4;
        vertical-align: middle;
        font-weight: 500;
    }

    .status-badge {
        padding: 8px 16px;
        border-radius: 25px;
        font-weight: 700;
        font-size: 13px;
        text-transform: uppercase;
    }

    .status-paid {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        color: #155724;
    }

    .status-overdue {
        background: linear-gradient(135deg, #f8d7da, #f5c6cb);
        color: #721c24;
        animation: pulse 2s infinite;
    }

    .status-due {
        background: linear-gradient(135deg, #fff3cd, #ffeaa7);
        color: #856404;
    }
 

    /* ===== BUTTONS ===== */
    .btn-modern {
        padding: 12px 35px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 15px;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(253,126,20,0.3);
    }

    .btn-secondary-modern {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        color: #6c757d;
        border: 1px solid #e3e6f0;
    }

    .btn-modern:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(253,126,20,0.4);
    }
 
</style>

<div class="content container-fluid">
    <!-- PAGE HEADER -->
    <div class="row mb-5 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1" style="color: #2c3e50;">
                <i class="fas fa-receipt me-2 text-warning"></i>
                Student Fees Report
            </h2>
            <p class="mb-0 text-muted fs-5">@Model.StudentName - @Model.ClassName</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary-modern btn-lg px-5">
                <i class="fas fa-arrow-left me-2"></i>Back to Fees
            </a>
        </div>
    </div>

    <!-- TOTALS DASHBOARD -->
    <div class="row mb-5 g-4">
        <div class="col-md-4">
            <div class="total-card">
                <div class="total-number">@Model.TotalPaid.ToString("N2")</div>
                <div class="fs-5 fw-bold">EGP Paid</div>
                <i class="fas fa-check-circle fs-1 opacity-75 mt-2"></i>
            </div>
        </div>
        <div class="col-md-4">
            <div class="total-card" style="background: linear-gradient(135deg, #28a745, #20c997);">
                <div class="total-number">@Model.TotalDue.ToString("N2")</div>
                <div class="fs-5 fw-bold">EGP Total Due</div>
                <i class="fas fa-calendar-alt fs-1 opacity-75 mt-2"></i>
            </div>
        </div>
        <div class="col-md-4">
            <div class="total-card" style="background: linear-gradient(135deg, #dc3545, #c82333);">
                <div class="total-number">@(Model.TotalOutstanding > 0 ? Model.TotalOutstanding.ToString("N2") : "0.00")</div>
                <div class="fs-5 fw-bold">EGP Outstanding</div>
                <i class="fas fa-exclamation-triangle fs-1 opacity-75 mt-2"></i>
            </div>
        </div>
    </div>

    <!-- FEES TABLE -->
    <div class="row">
        <div class="col-12">
            <div class="card dashboard-card">
                <div class="dashboard-header">
                    <div class="dashboard-icon">
                        <i class="fas fa-list text-white"></i>
                    </div>
                    <h4 class="mb-1 fw-bold">Payment History</h4>
                    <p class="mb-0 opacity-90">Detailed fee records for @Model.StudentName</p>
                </div>
                <div class="table-responsive">
                    <table class="table table-modern table-hover mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <i class="fas fa-calendar me-2"></i>
                                    Due Date
                                </th>
                                <th>
                                    <i class="fas fa-money-bill-wave me-2"></i>
                                    Amount (EGP)
                                </th>
                                <th>
                                    <i class="fas fa-circle-check me-2"></i>
                                    Status
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fee in Model.Fees)
                            {
                                <tr class="@(fee.Paid ? "table-success" : (fee.DaysOverdue > 0 ? "table-danger" : "table-warning"))">
                                    <td>
                                        <strong>@fee.DueDate.ToString("dd/MM/yyyy")</strong>
                                        @if(fee.DaysOverdue > 0)
                                        {
                                            <span class="badge bg-danger ms-2">Overdue @fee.DaysOverdue days</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-bold fs-5">@fee.Amount.ToString("N2") EGP</span>
                                    </td>
                                    <td>
                                        <span class="status-badge @(fee.Paid ? "status-paid" : (fee.DaysOverdue > 0 ? "status-overdue" : "status-due"))">
                                            @fee.PaymentStatus
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-dark">
                            <tr>
                                <th>Total Paid</th>
                                <th class="text-success fs-5">@Model.TotalPaid.ToString("N2") EGP</th>
                                <th></th>
                            </tr>
                            <tr>
                                <th>Total Due</th>
                                <th class="text-info fs-5">@Model.TotalDue.ToString("N2") EGP</th>
                                <th></th>
                            </tr>
                            <tr class="@(Model.TotalOutstanding > 0 ? "table-danger" : "table-success")">
                                <th>Total Outstanding</th>
                                <th class="fs-5 @(Model.TotalOutstanding > 0 ? "text-danger fw-bold" : "text-success fw-bold")">
                                    @Model.TotalOutstanding.ToString("N2") EGP
                                </th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- BACK BUTTON -->
    <div class="row mt-5">
        <div class="col-12 text-center">
            <a asp-action="Index" class="btn btn-secondary-modern btn-lg px-5 shadow-lg">
                <i class="fas fa-arrow-left me-2"></i>Back to Fees Dashboard
            </a>
        </div>
    </div>
</div>
