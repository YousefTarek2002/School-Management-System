@model FeeVM
@{
    ViewData["Title"] = "Add New Fee";
}

<style>
    .form-card {
        border: none;
        border-radius: 25px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 20px 50px rgba(0,0,0,0.12);
        overflow: hidden;
        height: 100%;
    }
    .form-header {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 35px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .form-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
        animation: float 6s ease-in-out infinite;
    }
   
    .form-icon {
        width: 90px;
        height: 90px;
        background: rgba(255,255,255,0.25);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin: 0 auto 20px;
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    .input-group-modern {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
        background: white;
        height: 65px;
        position: relative;
    }
    .input-group-modern:focus-within {
        border-color: #28a745;
        box-shadow: 0 0 0 0.3rem rgba(40,167,69,0.15), 0 10px 25px rgba(40,167,69,0.2);
        transform: translateY(-2px);
    }
    .input-group-text-modern {
        background: linear-gradient(135deg, #f0fff4, #e8f5e8);
        border: none;
        color: #28a745;
        font-weight: 600;
        display: flex;
        align-items: center;
        padding: 0 20px;
        height: 100%;
        position: absolute;
        left: 0;
        top: 0;
        z-index: 2;
    }
    .form-control-modern {
        border: none;
        padding: 20px 20px 20px 70px !important;
        font-size: 16px;
        background: transparent;
        height: 100%;
        box-shadow: none;
        position: relative;
        z-index: 1;
    }
    .form-control-modern:focus {
        box-shadow: none;
        background: #f8fff8;
    }
    .amount-input {
        font-size: 20px;
        font-weight: 700;
        color: #28a745;
        padding-right: 20px !important;
    }
    .checkbox-container {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 15px;
        border: 2px solid #dee2e6;
        padding: 20px;
        transition: all 0.3s ease;
        height: 72px;
        display: flex;
        align-items: center;
        cursor: pointer;
        position: relative;
    }
    .checkbox-container:hover {
        border-color: #28a745;
        background: linear-gradient(135deg, #e8f5e8 0%, #d4edda 100%);
        transform: translateY(-2px);
    }
    .checkbox-container.checked {
        border-color: #28a745;
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        box-shadow: 0 5px 20px rgba(40,167,69,0.2);
        transform: translateY(-2px);
    }
    .btn-modern {
        padding: 15px 40px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 16px;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(13,110,253,0.4);
        position: relative;
        overflow: hidden;
    }
    .btn-primary-modern { 
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%); 
        color: white; 
        box-shadow: 0 10px 30px rgba(40,167,69,0.4);
    }
    .btn-secondary-modern { 
        background: linear-gradient(135deg, #f8f9fa, #e9ecef); 
        color: #6c757d; 
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .btn-modern:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(40,167,69,0.5);
        color: white !important;
    }
    .label-modern {
        font-weight: 700;
        color: #2c3e50;
        font-size: 15px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .preview-card {
        background: linear-gradient(135deg, rgba(40,167,69,0.08) 0%, rgba(32,201,151,0.08) 100%);
        border-radius: 20px;
        border-left: 5px solid #28a745;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(40,167,69,0.15);
    }
</style>

<div class="content container-fluid">
    <!-- PAGE HEADER -->
    <div class="row mb-5 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-2" style="color: #2c3e50;">
                <i class="fas fa-money-bill-wave me-3 text-success"></i>
                Add New Fee
            </h2>
            <p class="mb-0 text-muted lead">Create fee record for student with due date tracking</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary-modern btn-lg shadow-lg px-5">
                <i class="fas fa-arrow-left me-2"></i>Back to Fees
            </a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-lg mb-5" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-lg mb-5" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- PREVIEW CARD -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="preview-card">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h5 class="mb-2">
                            <i class="fas fa-user-graduate text-primary me-2"></i>
                            <span id="previewStudent">Select Student</span>
                            <span id="previewAmount" class="text-success fw-bold fs-4 ms-3"></span>
                        </h5>
                        <p class="mb-0 text-muted fs-6" id="previewDueDate">Due Date: Select date</p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <span class="badge bg-success fs-6 px-4 py-3 shadow-sm" id="previewStatus">
                            <i class="fas fa-circle me-2"></i>Pending
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FORM CARD -->
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-11">
            <div class="card form-card shadow-xl">
                <!-- HEADER -->
                <div class="form-header">
                    <div class="form-icon">
                        <i class="fas fa-money-check-alt"></i>
                    </div>
                    <h3 class="mb-2 fw-bold fs-2 position-relative">Fee Information</h3>
                    <p class="mb-0 opacity-90 position-relative">Create new fee record with real-time preview</p>
                </div>

                <!-- FORM BODY -->
                <div class="card-body p-5">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 rounded-3 shadow-sm">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            Please fix the following errors before submitting:
                        </div>

                        <!-- ROW 1 -->
                        <div class="row g-4 mb-5">
                            <div class="col-lg-6">
                                <label class="label-modern">
                                    <i class="fas fa-user-graduate text-primary"></i>
                                    Student <span class="text-danger">*</span>
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-user-graduate"></i>
                                    </span>
                                    <select asp-for="StudentId" class="form-control-modern form-select" style="border: none; padding-left: 70px;">
                                        <option value="">Choose student...</option>
                                        @if (Model.Students != null)
                                        {
                                            @foreach (var student in Model.Students)
                                            {
                                                <option value="@student.Value">@student.Text</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="StudentId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-lg-6">
                                <label class="label-modern">
                                    <i class="fas fa-coins text-success"></i>
                                    Amount (EGP) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-egyptian-pound"></i>
                                    </span>
                                    <input asp-for="Amount" type="number" min="0" step="0.01" 
                                           class="form-control-modern amount-input" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- ROW 2 -->
                        <div class="row g-4 mb-5">
                            <div class="col-lg-6">
                                <label class="label-modern">
                                    <i class="fas fa-calendar text-warning"></i>
                                    Due Date <span class="text-danger">*</span>
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-calendar-alt"></i>
                                    </span>
                                    <input asp-for="DueDate" type="date" class="form-control-modern" />
                                </div>
                                <span asp-validation-for="DueDate" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-lg-6">
                                <label class="label-modern">
                                    <i class="fas fa-credit-card text-info"></i>
                                    Payment Status
                                </label>
                                <div class="checkbox-container @(Model.Paid ? "checked" : "")" onclick="togglePaid()">
                                    <div class="form-check d-flex align-items-center w-100 h-100">
                                        <input asp-for="Paid" class="form-check-input me-4" type="checkbox" id="paidCheck" onchange="updatePreview()">
                                        <label class="form-check-label mb-0 flex-grow-1 fw-semibold" for="paidCheck">
                                            <i class="fas fa-check-circle me-2 text-success"></i>
                                            Mark as Paid
                                            <div class="small text-muted mt-1">Check if fee has already been paid</div>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="text-center mt-5 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-secondary-modern btn-lg me-4 px-5 shadow-lg">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary-modern btn-lg px-5 shadow-lg">
                                <i class="fas fa-save me-2"></i>
                                Create Fee Record
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live preview update
        function updatePreview() {
            const studentSelect = document.querySelector('select[name="StudentId"]');
            const amountInput = document.querySelector('input[name="Amount"]');
            const dueDateInput = document.querySelector('input[name="DueDate"]');
            const paidCheck = document.querySelector('input[name="Paid"]');
            
            const studentName = studentSelect.selectedOptions[0]?.text || 'Select Student';
            const amount = amountInput?.value ? `${parseFloat(amountInput.value).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} EGP` : '';
            const dueDate = dueDateInput?.value ? new Date(dueDateInput.value).toLocaleDateString('en-GB') : 'Select date';
            const status = paidCheck?.checked ? 'Paid ✓' : 'Pending';
            const statusClass = paidCheck?.checked ? 'text-success' : 'text-warning';
            
            document.getElementById('previewStudent').textContent = studentName;
            document.getElementById('previewAmount').textContent = amount;
            document.getElementById('previewDueDate').textContent = `Due Date: ${dueDate}`;
            document.getElementById('previewStatus').innerHTML = `<i class="fas fa-circle me-2 ${statusClass}"></i>${status}`;
        }

        // Toggle checkbox container
        function togglePaid() {
            const checkbox = document.querySelector('#paidCheck');
            checkbox.checked = !checkbox.checked;
            updatePreview();
        }

        // Event listeners
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('select[name="StudentId"], input[name="Amount"], input[name="DueDate"], input[name="Paid"]').forEach(el => {
                el.addEventListener('change', updatePreview);
                el.addEventListener('input', updatePreview);
            });
            
            // Amount formatting
            const amountInput = document.querySelector('input[name="Amount"]');
            amountInput.addEventListener('input', function() {
                let value = parseFloat(this.value);
                if (value) {
                    this.value = value.toFixed(2);
                }
            });

            // Initial preview
            updatePreview();

            // Form animations
            document.querySelectorAll('.form-control-modern').forEach(input => {
                input.addEventListener('focus', function() {
                    this.closest('.input-group-modern').style.transform = 'scale(1.02)';
                });
                input.addEventListener('blur', function() {
                    this.closest('.input-group-modern').style.transform = 'scale(1)';
                });
            });
        });
    </script>
}
