@using School.Models.VM
@model IEnumerable<FeeVM>

<style>
    body {
        background: #f8f9fa;
    }

    .fee-card {
        border: 1px solid #e0e0e0;
        border-radius: 15px;
        background: #fff;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        transition: transform 0.3s, box-shadow 0.3s;
        height: 100%;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .fee-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }

    .fee-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        margin: 20px auto 10px;
    }

    .fee-avatar.paid { background-color: #28a745; }
    .fee-avatar.pending { background-color: #17a2b8; }
    .fee-avatar.overdue { background-color: #dc3545; }

    .fee-name {
        font-size: 18px;
        font-weight: 600;
        color: #2c3e50;
        text-align: center;
        margin-bottom: 5px;
    }

    .fee-name a { color: inherit; text-decoration: none; }
    .fee-name a:hover { color: #007bff; }

    .fee-meta {
        color: #6c757d;
        font-size: 13px;
        text-align: center;
        margin-bottom: 15px;
    }

    .amount-badge {
        font-size: 16px;
        font-weight: 600;
        padding: 10px 15px;
        border-radius: 20px;
        display: block;
        margin: 0 auto 10px;
        text-align: center;
        color: #fff;
    }

    .paid-badge { background-color: #28a745; }
    .pending-badge { background-color: #17a2b8; }
    .overdue-badge { background-color: #dc3545; }

    .status-badge {
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 11px;
        font-weight: 500;
        display: inline-block;
        margin-bottom: 8px;
        text-align: center;
        width: fit-content;
        margin-left: auto;
        margin-right: auto;
    }

    .card-actions {
        padding: 10px;
        border-top: 1px solid #eee;
        display: flex;
        gap: 8px;
        justify-content: center;
    }

    .btn-action {
        flex: 1;
        padding: 6px 12px;
        border-radius: 10px;
        font-weight: 500;
        font-size: 13px;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-edit { background-color: #28a745; color: white; }
    .btn-delete { background-color: #dc3545; color: white; }
    .btn-action:hover { opacity: 0.85; }

    /* Responsive grid spacing */
    .fee-item { margin-bottom: 20px; }
</style>

<div class="content container-fluid">
    <!-- HEADER -->
    <div class="page-header d-flex justify-content-between align-items-center">
        <h4>
            <i class="fas fa-money-bill-wave me-2 text-primary"></i>
            Fees <span class="badge bg-primary ms-2">@Model.Count()</span>
        </h4>
        <div class="d-flex gap-2">
            <input type="text" id="searchInput" class="form-control shadow-sm" style="width: 250px;" placeholder="🔍 Search by student name...">
            <a asp-action="Create" class="btn btn-success shadow-sm px-4">
                <i class="fas fa-plus me-2"></i>Add Fee
            </a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- GRID -->
    <div class="row mt-4" id="feeGrid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="empty-state text-muted">
                    <i class="fas fa-money-bill-wave fa-5x mb-3"></i>
                    <h3>No Fees Yet</h3>
                    <p class="lead">Get started by adding your first fee record</p>
                    <a asp-action="Create" class="btn btn-success btn-lg px-5">
                        <i class="fas fa-plus me-2"></i> Add First Fee
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var fee in Model)
            {
                var avatarClass = fee.Paid ? "paid" : (fee.DaysOverdue > 0 ? "overdue" : "pending");
                var amountClass = fee.Paid ? "paid-badge" : (fee.DaysOverdue > 0 ? "overdue-badge" : "pending-badge");
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 fee-item" data-name="@(fee.StudentName ?? "").ToLower()">
                    <div class="card fee-card h-100">
                        <div class="text-center pt-3">
                            <a asp-action="Edit" asp-route-id="@fee.Id" class="fee-avatar @avatarClass">
                                @(string.IsNullOrEmpty(fee.StudentName) ? "F" : fee.StudentName.Substring(0,1).ToUpper())
                            </a>
                        </div>
                        <div class="px-3">
                            <h5 class="fee-name">
                                <a asp-action="Edit" asp-route-id="@fee.Id">@(fee.StudentName ?? "Unnamed")</a>
                            </h5>
                            <div class="fee-meta"><i class="fas fa-school me-1"></i>@(fee.ClassName ?? "No Class")</div>
                            <span class="amount-badge @amountClass">
                                <i class="fas fa-money-bill me-1"></i>@fee.Amount EGP
                            </span>
                            <span class="status-badge bg-info">
                                <i class="fas fa-info-circle me-1"></i>@(fee.PaymentStatus ?? "Pending")
                            </span>

                            @if (!fee.Paid && fee.DaysOverdue > 0)
                            {
                                <div class="alert alert-danger mt-2 py-1 px-2 text-center mb-0">
                                    <i class="fas fa-clock me-1"></i> Overdue @fee.DaysOverdue days
                                </div>
                            }

                            <div class="small text-muted text-center mt-2">
                                <i class="fas fa-calendar me-1"></i>@fee.DueDate.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                        <div class="card-actions">
                            <a asp-action="Edit" asp-route-id="@fee.Id" class="btn-action btn-edit">
                                <i class="fas fa-edit me-1"></i>Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@fee.Id" method="post" class="d-inline flex-fill" onsubmit="return confirmDelete('@fee.StudentName')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-action btn-delete w-100 h-100">
                                    <i class="fas fa-trash me-1"></i>Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('searchInput').addEventListener('keyup', function() {
            const value = this.value.toLowerCase().trim();
            document.querySelectorAll('.fee-item').forEach(item => {
                const name = item.dataset.name;
                item.style.display = name.includes(value) ? '' : 'none';
            });
        });

        function confirmDelete(name) {
            return confirm(`⚠️ Delete fee for "${name || 'Student'}"? This action cannot be undone!`);
        }
    </script>
}