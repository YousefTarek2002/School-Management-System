@using School.Models.VM
@model IEnumerable<FeeVM>

<style>
    .fee-card {
        border: none;
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: all 0.4s ease;
        height: 100%;
        overflow: hidden;
        position: relative;
    }
    .fee-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }
    .fee-card.paid {
        border-left: 5px solid #28a745;
        background: linear-gradient(145deg, #d4edda, #c3e6cb);
    }
    .fee-card.overdue {
        border-left: 5px solid #dc3545;
        background: linear-gradient(145deg, #f8d7da, #f5c6cb);
    }
    .fee-avatar {
        width: 80px;
        height: 80px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 700;
        color: white;
        margin: 25px auto 20px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.2);
    }
    .fee-name {
        font-size: 22px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 10px;
        line-height: 1.3;
    }
    .fee-name a { color: inherit; text-decoration: none; }
    .fee-name a:hover { color: #007bff; }
    .fee-meta {
        color: #6c757d;
        font-size: 14px;
        margin-bottom: 15px;
    }
    .amount-badge {
        font-size: 20px;
        font-weight: 700;
        padding: 12px 20px;
        border-radius: 25px;
        border: none;
        display: block;
        margin: 0 auto 15px;
    }
    .paid-badge { 
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        box-shadow: 0 8px 25px rgba(40,167,69,0.4);
    }
    .overdue-badge { 
        background: linear-gradient(135deg, #dc3545, #c82333);
        color: white;
        box-shadow: 0 8px 25px rgba(220,53,69,0.4);
        animation: shake 0.5s ease-in-out infinite alternate;
    }
    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }
    .card-actions {
        padding: 20px;
        border-top: 1px solid #eee;
        background: #fafbfc;
        display: flex;
        gap: 8px;
        justify-content: center;
    }
    .btn-action {
        flex: 1;
        padding: 10px 15px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-edit { background: linear-gradient(45deg, #28a745, #20c997); color: white; }
    .btn-delete { background: linear-gradient(45deg, #dc3545, #c82333); color: white; }
    .btn-action:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.2); color: white !important; }
 
</style>

<div class="content container-fluid">
    <!-- HEADER -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h4 class="mb-0">
                    <i class="fas fa-money-bill-wave me-2 text-primary"></i>
                    Fees <span class="badge bg-primary ms-2">@Model.Count()</span>
                </h4>
            </div>
            <div class="col-md-6 text-end">
                <div class="d-flex gap-2 justify-content-end align-items-center">
                    <input type="text" id="searchInput" class="form-control shadow-sm" 
                           style="width: 280px;" placeholder="🔍 Search by student name...">
                    <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
                        <i class="fas fa-plus me-2"></i>Add Fee
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- GRID -->
    <div class="row mt-4" id="feeGrid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="empty-state">
                    <i class="fas fa-money-bill-wave fa-5x text-muted mb-4 opacity-75"></i>
                    <h3 class="text-muted mb-3">No Fees Yet</h3>
                    <p class="lead text-muted mb-4">Get started by adding your first fee record</p>
                    <a asp-action="Create" class="btn btn-primary btn-lg shadow-lg px-5">
                        <i class="fas fa-plus me-3"></i> Add First Fee
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var fee in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-4 fee-item"
                     data-name="@(fee.StudentName ?? "").ToLower()">
                    
                    <div class="card fee-card @(fee.Paid ? "paid" : (fee.DaysOverdue > 0 ? "overdue" : "")) h-100">
                        <!-- AVATAR -->
                        <div class="text-center pt-3">
                            <a asp-action="Edit" asp-route-id="@fee.Id" 
                               class="fee-avatar @(fee.Paid ? "bg-success" : "bg-danger") d-inline-block">
                                @(string.IsNullOrEmpty(fee.StudentName) ? "F" : fee.StudentName[0].ToString().ToUpper())
                            </a>
                        </div>

                        <!-- NAME & CLASS -->
                        <div class="text-center px-3">
                            <h5 class="fee-name">
                                <a asp-action="Edit" asp-route-id="@fee.Id">@(fee.StudentName ?? "Unnamed")</a>
                            </h5>
                            <div class="fee-meta">
                                <i class="fas fa-school me-1"></i> @(fee.ClassName ?? "No Class")
                            </div>
                        </div>

                        <!-- AMOUNT & STATUS -->
                        <div class="px-4 pb-3">
                            <span class="amount-badge @(fee.Paid ? "paid-badge" : "overdue-badge")">
                                <i class="fas fa-money-bill me-2"></i>@fee.Amount EGP
                            </span>
                            <span class="status-badge bg-info mx-auto d-block mt-2">
                                <i class="fas fa-info-circle me-1"></i>@(fee.PaymentStatus ?? "Pending")
                            </span>
                            
                            @if (!fee.Paid && fee.DaysOverdue > 0)
                            {
                                <div class="alert alert-danger border-0 rounded-3 mt-2 p-2">
                                    <i class="fas fa-clock me-2"></i> Overdue @fee.DaysOverdue days
                                </div>
                            }
                        </div>

                        <!-- DUE DATE -->
                        <div class="px-3 pb-3 small text-muted text-center">
                            <i class="fas fa-calendar @(fee.Paid ? "text-success" : "text-danger") me-1"></i>
                            @fee.DueDate.ToString("dd/MM/yyyy")
                        </div>

                        <!-- ACTIONS -->
                        <div class="card-actions">
                            <a asp-action="Edit" asp-route-id="@fee.Id" class="btn-action btn-edit">
                                <i class="fas fa-edit me-1"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@fee.Id" method="post" 
                                  class="d-inline" style="flex:1;" 
                                  onsubmit="return confirmDelete('@fee.StudentName')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-action btn-delete w-100 h-100 p-2 border-0">
                                    <i class="fas fa-trash me-1"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- SUMMARY STATS -->
    @if (Model.Any())
    {
        <div class="row mt-5">
            <div class="col-md-3">
                <div class="card text-center bg-success text-white shadow-lg">
                    <div class="card-body">
                        <i class="fas fa-check-circle fa-3x mb-3 opacity-75"></i>
                        <h3>@Model.Count(f => f.Paid)</h3>
                        <p class="mb-0">Paid</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-danger text-white shadow-lg">
                    <div class="card-body">
                        <i class="fas fa-times-circle fa-3x mb-3 opacity-75"></i>
                        <h3>@Model.Count(f => !f.Paid)</h3>
                        <p class="mb-0">Pending</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-warning text-white shadow-lg">
                    <div class="card-body">
                        <i class="fas fa-exclamation-triangle fa-3x mb-3 opacity-75"></i>
                        <h3>@Model.Count(f => !f.Paid && f.DaysOverdue > 0)</h3>
                        <p class="mb-0">Overdue</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center bg-info text-white shadow-lg">
                    <div class="card-body">
                        <i class="fas fa-coins fa-3x mb-3 opacity-75"></i>
                        <h3>@Model.Sum(f => f.Amount) EGP</h3>
                        <p class="mb-0">Total</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // 🔍 البحث بالاسم بس (StudentName)
        document.getElementById('searchInput').addEventListener('keyup', function() {
            const value = this.value.toLowerCase().trim();
            document.querySelectorAll('.fee-item').forEach(item => {
                const name = item.dataset.name;
                item.style.display = name.includes(value) ? '' : 'none';
            });
        });

        // Delete confirmation
        function confirmDelete(name) {
            return confirm(`⚠️ Delete fee for "${name || 'Student'}"?\n\nThis action cannot be undone!`);
        }

        // Animate cards on load
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.fee-card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(30px)';
                setTimeout(() => {
                    card.style.transition = 'all 0.6s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
}
