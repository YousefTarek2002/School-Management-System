@model School.Models.BookIssue
@{
    ViewData["Title"] = "Issue Book";
    var book = ViewBag.Book as School.Models.Book;
    var students = ViewBag.Students as IEnumerable<School.Models.Student>;
}

<style>
    .form-card {
        border: none;
        border-radius: 25px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 20px 50px rgba(0,0,0,0.12);
        overflow: hidden;
        height: 100%;
    }
    .form-header {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 35px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .form-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, transparent 70%);
        animation: float 6s ease-in-out infinite;
    }
   
    .form-icon {
        width: 90px;
        height: 90px;
        background: rgba(255,255,255,0.25);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin: 0 auto 20px;
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    .input-group-modern {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
        background: white;
        height: 65px;
        position: relative;
    }
    .input-group-modern:focus-within {
        border-color: #28a745;
        box-shadow: 0 0 0 0.3rem rgba(40,167,69,0.15), 0 10px 25px rgba(40,167,69,0.2);
        transform: translateY(-2px);
    }
    .input-group-text-modern {
        background: linear-gradient(135deg, #f0fff4, #e8f5e8);
        border: none;
        color: #28a745;
        font-weight: 600;
        display: flex;
        align-items: center;
        padding: 0 20px;
        height: 100%;
    }
    .form-control-modern {
        border: none;
        padding: 20px 20px 20px 70px !important;
        font-size: 16px;
        background: transparent;
        height: 100%;
        box-shadow: none;
    }
    .form-control-modern:focus {
        box-shadow: none;
        background: #f8fff8;
    }
    .book-card {
        background: linear-gradient(135deg, rgba(40,167,69,0.08) 0%, rgba(32,201,151,0.08) 100%);
        border-radius: 20px;
        border: 2px solid rgba(40,167,69,0.2);
        box-shadow: 0 15px 35px rgba(40,167,69,0.15);
        transition: all 0.3s ease;
    }
    .book-avatar {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, #28a745, #20c997);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        font-weight: 700;
        color: white;
        box-shadow: 0 15px 35px rgba(40,167,69,0.4);
        margin: 0 auto 20px;
        position: relative;
        overflow: hidden;
    }
    .book-avatar::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
        animation: rotate 8s linear infinite;
    }
     
    .availability-badge {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        color: #155724;
        font-weight: 700;
        padding: 12px 24px;
        border-radius: 50px;
        font-size: 18px;
        box-shadow: 0 8px 25px rgba(40,167,69,0.3);
    }
    .btn-modern {
        padding: 15px 40px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 16px;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 10px 30px rgba(40,167,69,0.4);
    }
    .btn-success-modern { 
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%); 
        color: white; 
    }
    .btn-secondary-modern { 
        background: linear-gradient(135deg, #f8f9fa, #e9ecef); 
        color: #6c757d; 
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .btn-modern:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(40,167,69,0.5);
        color: white !important;
    }
    .label-modern {
        font-weight: 700;
        color: #2c3e50;
        font-size: 15px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
</style>

<div class="content container-fluid">
    <!-- PAGE HEADER -->
    <div class="row mb-5 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-2" style="color: #2c3e50;">
                <i class="fas fa-book me-3 text-success"></i>
                Issue Book
            </h2>
            <p class="mb-0 text-muted lead">Issue book to selected student from library</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary-modern btn-lg shadow-lg px-5">
                <i class="fas fa-arrow-left me-2"></i>Back to Books
            </a>
        </div>
    </div>

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-lg mb-5" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-lg mb-5" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- FORM CARD -->
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-11">
            <div class="card form-card shadow-xl">
                <!-- HEADER -->
                <div class="form-header">
                    <div class="form-icon">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <h3 class="mb-2 fw-bold fs-2 position-relative">Issue Book</h3>
                    <p class="mb-0 opacity-90 position-relative">@book?.Title by @book?.Author</p>
                </div>

                <!-- FORM BODY -->
                <div class="card-body p-5">
                    <!-- BOOK INFO & AVAILABILITY -->
                    <div class="row mb-5">
                        <div class="col-lg-7">
                            <div class="book-card p-4 text-center">
                                <div class="book-avatar">
                                    @book?.Title[0]
                                </div>
                                <h4 class="mb-2 fw-bold">@book?.Title</h4>
                                <p class="text-muted mb-4 fs-5">by <strong>@book?.Author</strong></p>
                                <div class="availability-badge">
                                    <i class="fas fa-check-circle me-2"></i>
                                    @book?.CopiesAvailable / @book?.TotalCopies copies available
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="preview-student p-4 h-100 d-flex align-items-center justify-content-center text-center" 
                                 id="previewStudentCard">
                                <div>
                                    <i class="fas fa-user-graduate fa-4x text-muted mb-4"></i>
                                    <h5 class="text-muted mb-2">No student selected</h5>
                                    <p class="text-muted mb-0">Choose a student to issue the book</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STUDENT SELECTION FORM -->
                    <form method="post" asp-action="IssueBook">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookId" value="@book?.Id" />

                        <div class="row g-4">
                            <div class="col-12">
                                <label class="label-modern">
                                    <i class="fas fa-user-graduate text-primary"></i>
                                    Select Student <span class="text-danger">*</span>
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-user-friends"></i>
                                    </span>
                                    <select name="studentId" class="form-control-modern form-select" id="studentSelect" required onchange="updateStudentPreview()" style="border: none; padding-left: 70px;">
                                        <option value="">Choose a student...</option>
                                        @if (students != null)
                                        {
                                            @foreach (var student in students)
                                            {
                                                <option value="@student.Id" data-name="@(student.FirstName + " " + student.LastName)">
                                                    @student.FirstName @student.LastName (ID: @student.Id)
                                                </option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="form-text mt-2">
                                    <i class="fas fa-info-circle text-info me-1"></i>
                                    اختر الطالب الذي تريد إعارة الكتاب له
                                </div>
                            </div>
                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="text-center mt-5 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-secondary-modern btn-lg me-4 px-5 shadow-lg">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-success-modern btn-lg px-5 shadow-lg" id="issueBtn">
                                <i class="fas fa-book me-2"></i>
                                Issue Book to Student
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateStudentPreview() {
            const studentSelect = document.getElementById('studentSelect');
            const previewCard = document.getElementById('previewStudentCard');
            const issueBtn = document.getElementById('issueBtn');
            
            if (studentSelect.value) {
                const selectedOption = studentSelect.options[studentSelect.selectedIndex];
                const studentName = selectedOption.dataset.name || 'Student';
                
                previewCard.innerHTML = `
                    <div class="w-100">
                        <i class="fas fa-user-graduate fa-3x text-success mb-4"></i>
                        <h4 class="mb-2 fw-bold text-primary">${studentName}</h4>
                        <div class="badge bg-success fs-6 px-4 py-2 mb-3">
                            <i class="fas fa-check-circle me-2"></i>Ready to Issue
                        </div>
                        <p class="text-success mb-0 fw-semibold">
                            <i class="fas fa-book me-2"></i>${document.querySelector('.book-card h4').textContent}
                        </p>
                    </div>
                `;
                previewCard.style.background = 'linear-gradient(135deg, rgba(40,167,69,0.15) 0%, rgba(32,201,151,0.15) 100%)';
                previewCard.style.border = '2px solid rgba(40,167,69,0.3)';
                issueBtn.disabled = false;
            } else {
                previewCard.innerHTML = `
                    <div>
                        <i class="fas fa-user-graduate fa-4x text-muted mb-4"></i>
                        <h5 class="text-muted mb-2">No student selected</h5>
                        <p class="text-muted mb-0">Choose a student to issue the book</p>
                    </div>
                `;
                previewCard.style.background = 'transparent';
                previewCard.style.border = '2px dashed #dee2e6';
                issueBtn.disabled = true;
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Initialize student preview
            updateStudentPreview();
            
            // Form animations
            document.querySelectorAll('.form-control-modern').forEach(input => {
                input.addEventListener('focus', function() {
                    this.closest('.input-group-modern').style.transform = 'scale(1.02)';
                });
                input.addEventListener('blur', function() {
                    this.closest('.input-group-modern').style.transform = 'scale(1)';
                });
            });
        });
    </script>
}
