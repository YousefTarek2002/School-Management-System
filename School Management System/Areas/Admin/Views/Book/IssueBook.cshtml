@{
    ViewData["Title"] = "Issue Book";
    var book = ViewBag.Book as Book;
    var students = ViewBag.Students as IEnumerable<Student>;
}

<style>
    /* ===== MAIN CARD ===== */
    .form-card-modern {
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        overflow: hidden;
        border: none;
    }

    /* ===== HEADER ===== */
    .form-header-modern {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        padding: 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .form-header-icon-modern {
        width: 75px;
        height: 75px;
        background: rgba(255,255,255,0.25);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        margin: 0 auto 15px;
        backdrop-filter: blur(12px);
    }

    /* ===== BOOK INFO CARD ===== */
    .book-info-card {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        border: 2px solid #28a745;
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(40,167,69,0.2);
    }

    .book-icon {
        width: 60px;
        height: 60px;
        background: rgba(255,255,255,0.3);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin: 0 auto 15px;
    }

    /* ===== INPUT GROUP ===== */
    .input-group-modern {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
        background: white;
        margin-bottom: 25px;
    }

        .input-group-modern:focus-within {
            border-color: #28a745;
            box-shadow: 0 10px 30px rgba(40,167,69,0.25);
            transform: translateY(-2px);
        }

    .input-group-text-modern {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        border: none;
        color: #28a745;
        font-weight: 600;
        padding: 15px 20px;
        display: flex;
        align-items: center;
    }

    .form-control-modern {
        border: none;
        padding: 15px 20px;
        font-size: 16px;
        background: transparent;
        box-shadow: none;
    }

        .form-control-modern:focus {
            box-shadow: none;
            background: #f8fff8;
        }

    /* ===== LABELS ===== */
    .label-modern {
        font-weight: 700;
        color: #2c3e50;
        font-size: 15px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ===== BUTTONS ===== */
    .btn-modern {
        padding: 14px 40px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 16px;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(40,167,69,0.3);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-primary-modern {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
    }

    .btn-secondary-modern {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        color: #6c757d;
        border: 1px solid #e3e6f0;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .btn-modern:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(40,167,69,0.4);
        color: white !important;
    }

    /* ===== ALERTS ===== */
    .alert-modern {
        border-radius: 12px;
        padding: 15px 20px;
        margin-bottom: 25px;
        border: none;
        font-weight: 500;
    }

    .available-badge {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        padding: 8px 20px;
        border-radius: 25px;
        font-weight: 700;
        font-size: 14px;
    }
</style>

<div class="content container-fluid">
    <!-- PAGE HEADER -->
    <div class="row mb-5 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1" style="color: #2c3e50;">
                <i class="fas fa-book-reader me-2 text-success"></i>
                Issue Book
            </h2>
            <p class="mb-0 text-muted fs-6">Assign book to student</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary-modern btn-lg px-4">
                <i class="fas fa-arrow-left me-1"></i>Back to Books
            </a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-modern shadow-sm">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["success"]
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-modern shadow-sm">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["error"]
        </div>
    }

    <!-- MAIN FORM CARD -->
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card form-card-modern shadow-lg">
                <div class="form-header-modern">
                    <div class="form-header-icon-modern">
                        <i class="fas fa-handshake text-white"></i>
                    </div>
                    <h4 class="mb-1 fw-bold">Issue Book</h4>
                    <p class="mb-0 opacity-90">Select student to issue this book</p>
                </div>

                <div class="card-body p-5">
                    <!-- BOOK INFORMATION -->
                    <div class="book-info-card">
                        <div class="book-icon">
                            <i class="fas fa-book text-white"></i>
                        </div>
                        <h5 class="fw-bold mb-3 text-success text-center">
                            <i class="fas fa-book me-2"></i>@book.Title
                        </h5>
                        <div class="row text-center">
                            <div class="col-md-6">
                                <div class="fs-5 fw-bold text-muted mb-1">Author</div>
                                <div class="text-info">@(book.Author ?? "N/A")</div>
                            </div>
                            <div class="col-md-6">
                                <div class="fs-5 fw-bold text-muted mb-1">Available</div>
                                <span class="available-badge">@book.CopiesAvailable copies</span>
                            </div>
                        </div>
                    </div>

                    <form asp-action="IssueBook" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="bookId" value="@book.Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-modern mb-5 shadow-sm d-none">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            Please fix the following errors:
                        </div>

                        <!-- STUDENT SELECT -->
                        <div class="mb-5">
                            <label class="label-modern">
                                <i class="fas fa-user-graduate text-primary"></i>
                                Select Student <span class="text-danger">*</span>
                            </label>
                            <div class="input-group-modern">
                                <span class="input-group-text-modern">
                                    <i class="fas fa-user-graduate"></i>
                                </span>
                                <select name="studentId" class="form-control-modern form-select" required>
                                    <option value="">-- Choose Student --</option>
                                    @foreach (var student in students)
                                    {
                                        <option value="@student.Id">
                                            @student.FirstName @student.LastName (@student.Email)
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="text-center pt-4 border-top">
                            <a asp-action="Index" class="btn btn-secondary-modern btn-lg me-3 px-5 shadow-sm">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary-modern btn-lg px-5 shadow-sm">
                                <i class="fas fa-paper-plane me-2"></i>Issue Book
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
