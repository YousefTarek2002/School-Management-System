@model IEnumerable<Book>

<style>
    .book-card {
        border: none;
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: all 0.4s ease;
        height: 100%;
        overflow: hidden;
    }
    .book-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }
    .book-avatar {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #ff6b6b, #feca57);
        color: white;
        font-size: 30px;
        font-weight: 700;
        border-radius: 15px;
        margin: 25px auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(255,107,107,0.4);
    }
    .book-title {
        font-size: 20px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 10px;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .book-author {
        color: #6c757d;
        font-size: 15px;
        margin-bottom: 15px;
    }
    .book-stats {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }
    .book-badge {
        padding: 8px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        flex: 1;
        min-width: 80px;
        text-align: center;
    }
    .badge-total { background: linear-gradient(45deg, #17a2b8, #138496); color: white; }
    .badge-available { 
        background: linear-gradient(45deg, #28a745, #20c997); 
        color: white; 
    }
    .badge-issued { 
        background: linear-gradient(45deg, #ffc107, #ff8c00); 
        color: white; 
    }
    .badge-danger { 
        background: linear-gradient(45deg, #dc3545, #c82333); 
        color: white; 
    }
    .card-actions {
        padding: 20px;
        border-top: 1px solid #eee;
        background: #fafbfc;
        display: flex;
        gap: 6px;
        justify-content: center;
        flex-wrap: wrap;
    }
    .btn-action {
        flex: 1;
        min-width: 70px;
        padding: 8px 12px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 13px;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-edit { background: linear-gradient(45deg, #28a745, #20c997); color: white; }
    .btn-issue { background: linear-gradient(45deg, #007bff, #0056b3); color: white; }
    .btn-delete { background: linear-gradient(45deg, #dc3545, #c82333); color: white; }
    .btn-action:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.2); color: white !important; }
</style>

<div class="content container-fluid">
    <!-- HEADER -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h4 class="mb-0">
                    <i class="fas fa-book me-2 text-primary"></i>
                    Books <span class="badge bg-primary ms-2">@Model.Count()</span>
                </h4>
            </div>
            <div class="col-md-6 text-end">
                <div class="d-flex gap-2 justify-content-end align-items-center">
                    <input type="text" id="searchInput" class="form-control shadow-sm" 
                           style="width: 280px;" placeholder="🔍 Search by title or author...">
                    <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
                        <i class="fas fa-plus me-2"></i>Add Book
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- GRID -->
    <div class="row mt-4" id="bookGrid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="empty-state">
                    <i class="fas fa-book fa-5x text-muted mb-4 opacity-75"></i>
                    <h3 class="text-muted mb-3">No Books Yet</h3>
                    <p class="lead text-muted mb-4">Get started by adding your first book</p>
                    <a asp-action="Create" class="btn btn-primary btn-lg shadow-lg px-5">
                        <i class="fas fa-plus me-3"></i> Add First Book
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var book in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-4 book-item"
                     data-title="@(book.Title ?? "").ToLower()"
                     data-author="@(book.Author ?? "").ToLower()">
                    
                    <div class="card book-card h-100">
                        <!-- AVATAR & TITLE -->
                        <div class="text-center pt-3">
                            <div class="book-avatar">
                                @(book.Title?.Length > 0 ? book.Title[0].ToString().ToUpper() : "B")
                            </div>
                            <h5 class="book-title px-3">@(book.Title ?? "Untitled Book")</h5>
                            <div class="book-author px-3">@(book.Author ?? "Unknown Author")</div>
                        </div>

                        <!-- STATS -->
                        <div class="px-4 pb-3">
                            <div class="book-stats">
                                <span class="book-badge badge-total">
                                    <i class="fas fa-copy me-1"></i>@book.TotalCopies
                                </span>
                                <span class="book-badge @(book.CopiesAvailable > 0 ? "badge-available" : "badge-danger")">
                                    <i class="fas fa-check-circle me-1"></i>@book.CopiesAvailable
                                </span>
                                <span class="book-badge badge-issued">
                                    <i class="fas fa-hand-holding me-1"></i>@(book.TotalCopies - book.CopiesAvailable)
                                </span>
                            </div>
                        </div>

                        <!-- ACTIONS -->
                        <div class="card-actions">
                            <a asp-action="Edit" asp-route-id="@book.Id" class="btn-action btn-edit">
                                <i class="fas fa-edit me-1"></i> Edit
                            </a>
                            @if (book.CopiesAvailable > 0)
                            {
                                <a asp-action="IssueBook" asp-route-bookId="@book.Id" class="btn-action btn-issue">
                                    <i class="fas fa-hand-holding me-1"></i> Issue
                                </a>
                            }
                            <form asp-action="Delete" asp-route-id="@book.Id" method="post" 
                                  class="d-inline" style="flex:1; min-width: 80px;" 
                                  onsubmit="return confirmDelete('@book.Title')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-action btn-delete w-100 h-100 p-2 border-0">
                                    <i class="fas fa-trash me-1"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        // 🔍 البحث بالـ Title + Author
        document.getElementById('searchInput').addEventListener('keyup', function() {
            const value = this.value.toLowerCase().trim();
            document.querySelectorAll('.book-item').forEach(item => {
                const title = item.dataset.title;
                const author = item.dataset.author;
                item.style.display = (title.includes(value) || author.includes(value)) ? '' : 'none';
            });
        });

        // Delete confirmation
        function confirmDelete(title) {
            return confirm(`⚠️ Delete "${title || 'Book'}"?\n\nThis action cannot be undone!`);
        }

        // Animate cards on load
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.book-card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(30px)';
                setTimeout(() => {
                    card.style.transition = 'all 0.6s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
}
