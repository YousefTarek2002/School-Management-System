@model Book
@{
    ViewData["Title"] = "Edit Book";
}

<style>
    /* ===== MAIN CARD ===== */
    .form-card-modern {
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        overflow: hidden;
        border: none;
    }

    /* ===== HEADER ===== */
    .form-header-modern {
        background: linear-gradient(135deg, #6610f2 0%, #6f42c1 100%);
        color: white;
        padding: 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .form-header-icon-modern {
        width: 75px;
        height: 75px;
        background: rgba(255,255,255,0.25);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        margin: 0 auto 15px;
        backdrop-filter: blur(12px);
    }

    /* ===== INPUT GROUP ===== */
    .input-group-modern {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
        background: white;
        margin-bottom: 25px;
    }

        .input-group-modern:focus-within {
            border-color: #6610f2;
            box-shadow: 0 10px 30px rgba(102,16,242,0.25);
            transform: translateY(-2px);
        }

    .input-group-text-modern {
        background: linear-gradient(135deg, #f3e8ff, #e9d5ff);
        border: none;
        color: #6610f2;
        font-weight: 600;
        padding: 15px 20px;
        display: flex;
        align-items: center;
    }

    .form-control-modern {
        border: none;
        padding: 15px 20px;
        font-size: 16px;
        background: transparent;
        box-shadow: none;
    }

        .form-control-modern:focus {
            box-shadow: none;
            background: #f8f0ff;
        }

    /* ===== LABELS ===== */
    .label-modern {
        font-weight: 700;
        color: #2c3e50;
        font-size: 15px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ===== NUMBER INPUTS ROW ===== */
    .number-inputs-modern {
        display: flex;
        gap: 20px;
    }

    .number-input-group {
        flex: 1;
    }

    .number-badge {
        background: linear-gradient(135deg, #f3e8ff, #e9d5ff);
        color: #6610f2;
        padding: 8px 15px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 14px;
        min-width: 80px;
        text-align: center;
        margin-top: 5px;
    }

    /* ===== BUTTONS ===== */
    .btn-modern {
        padding: 14px 40px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 16px;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(102,16,242,0.3);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-primary-modern {
        background: linear-gradient(135deg, #6610f2, #6f42c1);
        color: white;
    }

    .btn-secondary-modern {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        color: #6c757d;
        border: 1px solid #e3e6f0;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .btn-modern:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(102,16,242,0.4);
        color: white !important;
    }

    /* ===== ALERTS ===== */
    .alert-modern {
        border-radius: 12px;
        padding: 15px 20px;
        margin-bottom: 25px;
        border: none;
        font-weight: 500;
    }
</style>

<div class="content container-fluid">
    <!-- PAGE HEADER -->
    <div class="row mb-5 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1" style="color: #2c3e50;">
                <i class="fas fa-edit me-2 text-primary"></i>
                Edit Book
            </h2>
            <p class="mb-0 text-muted fs-6">Update book information</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Index" class="btn btn-secondary-modern btn-lg px-4">
                <i class="fas fa-arrow-left me-1"></i>Back to Books
            </a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-modern shadow-sm">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["success"]
        </div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-modern shadow-sm">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["error"]
        </div>
    }

    <!-- FORM CARD -->
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card form-card-modern shadow-lg">
                <div class="form-header-modern">
                    <div class="form-header-icon-modern">
                        <i class="fas fa-edit text-white"></i>
                    </div>
                    <h4 class="mb-1 fw-bold">Update Book</h4>
                    <p class="mb-0 opacity-90">Modify book details</p>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <input asp-for="Id" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-modern mb-5 shadow-sm">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            Please fix the following errors:
                        </div>

                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <label asp-for="Title" class="label-modern">
                                    <i class="fas fa-heading text-primary"></i>
                                    Title
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-heading"></i>
                                    </span>
                                    <input asp-for="Title" class="form-control-modern" placeholder="Enter book title" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Author" class="label-modern">
                                    <i class="fas fa-user text-info"></i>
                                    Author
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <input asp-for="Author" class="form-control-modern" placeholder="Enter author name" />
                                </div>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="TotalCopies" class="label-modern">
                                    <i class="fas fa-copy text-success"></i>
                                    Total Copies
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-copy"></i>
                                    </span>
                                    <input asp-for="TotalCopies" type="number" min="1" class="form-control-modern" placeholder="0" />
                                    <span class="number-badge">Total</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CopiesAvailable" class="label-modern">
                                    <i class="fas fa-check-circle text-info"></i>
                                    Available Copies
                                </label>
                                <div class="input-group-modern">
                                    <span class="input-group-text-modern">
                                        <i class="fas fa-check-circle"></i>
                                    </span>
                                    <input asp-for="CopiesAvailable" type="number" min="0" class="form-control-modern" placeholder="0" />
                                    <span class="number-badge">Available</span>
                                </div>
                            </div>
                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="text-center pt-4 border-top mt-4">
                            <a asp-action="Index" class="btn btn-secondary-modern btn-lg me-3 px-5 shadow-sm">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary-modern btn-lg px-5 shadow-sm">
                                <i class="fas fa-save me-2"></i>Update Book
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
