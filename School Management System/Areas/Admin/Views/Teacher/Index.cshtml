@using School.Models.VM
@model IEnumerable<TeacherVM>

<style>
    .teacher-card {
        border: none;
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: all 0.4s ease;
        height: 100%;
        overflow: hidden;
    }
    .teacher-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }
    .teacher-avatar {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        font-size: 30px;
        font-weight: 700;
        border-radius: 50%;
        margin: 25px auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }
    .teacher-name {
        font-size: 22px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 10px;
        line-height: 1.3;
    }
    .teacher-name a { color: inherit; text-decoration: none; }
    .teacher-name a:hover { color: #667eea; }
    .teacher-meta {
        color: #6c757d;
        font-size: 14px;
        margin-bottom: 15px;
    }
    .teacher-badges {
        margin-bottom: 25px;
    }
    .teacher-badge {
        padding: 8px 16px;
        margin: 5px;
        border-radius: 25px;
        font-size: 13px;
        font-weight: 600;
        display: inline-block;
    }
    .badge-success { background: linear-gradient(45deg, #28a745, #20c997); color: white; }
    .badge-primary { background: linear-gradient(45deg, #007bff, #0056b3); color: white; }
    .card-actions {
        padding: 20px;
        border-top: 1px solid #eee;
        background: #fafbfc;
        display: flex;
        gap: 8px;
        justify-content: center;
    }
    .btn-action {
        flex: 1;
        padding: 10px 15px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-details { background: linear-gradient(45deg, #17a2b8, #138496); color: white; }
    .btn-edit { background: linear-gradient(45deg, #28a745, #20c997); color: white; }
    .btn-delete { background: linear-gradient(45deg, #dc3545, #c82333); color: white; }
    .btn-action:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.2); color: white !important; }
</style>

<div class="content container-fluid">
    <!-- HEADER -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h4 class="mb-0">
                    <i class="fas fa-users me-2 text-primary"></i>
                    Teachers <span class="badge bg-primary ms-2">@Model.Count()</span>
                </h4>
            </div>
            <div class="col-md-6 text-end">
                <div class="d-flex gap-2 justify-content-end align-items-center">
                    <input type="text" id="searchInput" class="form-control shadow-sm" 
                           style="width: 280px;" placeholder="🔍 Search by name...">
                    <a asp-action="Add" class="btn btn-primary shadow-sm px-4">
                        <i class="fas fa-plus me-2"></i>Add Teacher
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mt-3" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- GRID -->
    <div class="row mt-4" id="teacherGrid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="empty-state">
                    <i class="fas fa-chalkboard-teacher fa-5x text-muted mb-4 opacity-75"></i>
                    <h3 class="text-muted mb-3">No Teachers Yet</h3>
                    <p class="lead text-muted mb-4">Get started by adding your first teacher</p>
                    <a asp-action="Create" class="btn btn-primary btn-lg shadow-lg px-5">
                        <i class="fas fa-plus me-3"></i> Add First Teacher
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var teacher in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-4 teacher-item"
                     data-name="@(teacher.Name ?? "").ToLower()">
                    
                    <div class="card teacher-card h-100">
                        <!-- AVATAR & NAME -->
                        <div class="text-center pt-4">
                            <div class="teacher-avatar">
                                @(teacher.Name?.Length > 0 ? teacher.Name[0].ToString().ToUpper() : "T")
                            </div>
                            <h5 class="teacher-name">
                                <a asp-action="Details" asp-route-id="@teacher.Id">@(teacher.Name ?? "Unnamed")</a>
                            </h5>
                            <div class="teacher-meta">
                                <i class="fas fa-envelope me-1"></i> @(teacher.Email ?? "No email")
                            </div>
                        </div>

                        <!-- INFO -->
                        <div class="px-4 pb-4">
                            <div class="teacher-badges">
                                <span class="teacher-badge badge-success">
                                    <i class="fas fa-book me-1"></i>@(teacher.SubjectName ?? "No Subject")
                                </span>
                                <span class="teacher-badge badge-primary">
                                    <i class="fas fa-money-bill-wave me-1"></i>
                                    @(teacher.Salary > 0 ? teacher.Salary.ToString("N0") : "0") EGP
                                </span>
                            </div>
                        </div>

                        <!-- ACTIONS -->
                        <div class="card-actions">
                           
                            <a asp-action="Edit" asp-route-id="@teacher.Id" class="btn-action btn-edit">
                                <i class="fas fa-edit me-1"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@teacher.Id" method="post" 
                                  class="d-inline" style="flex:1;" onsubmit="return confirmDelete('@teacher.Name')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-action btn-delete w-100 h-100 p-2 border-0">
                                    <i class="fas fa-trash me-1"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        // 🔍 البحث بالاسم بس
        document.getElementById('searchInput').addEventListener('keyup', function() {
            const value = this.value.toLowerCase().trim();
            document.querySelectorAll('.teacher-item').forEach(item => {
                const name = item.dataset.name;
                item.style.display = name.includes(value) ? '' : 'none';
            });
        });

        // Delete confirmation
        function confirmDelete(name) {
            return confirm(`⚠️ Delete "${name || 'Teacher'}"?\n\nThis action cannot be undone!`);
        }

        // Animate cards on load
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.teacher-card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(30px)';
                setTimeout(() => {
                    card.style.transition = 'all 0.6s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });
    </script>
}
