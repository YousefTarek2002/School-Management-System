@using School.Models.VM
@model IEnumerable<TeacherVM>

<style>
    .teacher-card {
        border: none;
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: all 0.4s ease;
        height: 100%;
        overflow: hidden;
    }
    .teacher-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }
    .teacher-avatar {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        font-size: 30px;
        font-weight: 700;
        border-radius: 50%;
        margin: 25px auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }
    .teacher-name {
        font-size: 22px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 10px;
        line-height: 1.3;
    }
    .teacher-name a { color: inherit; text-decoration: none; }
    .teacher-name a:hover { color: #667eea; }
    .teacher-meta {
        color: #6c757d;
        font-size: 14px;
        margin-bottom: 15px;
    }
    .teacher-badges {
        margin-bottom: 25px;
    }
    .teacher-badge {
        padding: 8px 16px;
        margin: 5px;
        border-radius: 25px;
        font-size: 13px;
        font-weight: 600;
        display: inline-block;
    }
    .badge-success { background: linear-gradient(45deg, #28a745, #20c997); color: white; }
    .badge-primary { background: linear-gradient(45deg, #007bff, #0056b3); color: white; }
    .card-actions {
        padding: 20px;
        border-top: 1px solid #eee;
        background: #fafbfc;
        display: flex;
        gap: 8px;
        justify-content: center;
    }
    .btn-action {
        flex: 1;
        padding: 10px 15px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-details { background: linear-gradient(45deg, #17a2b8, #138496); color: white; }
    .btn-edit { background: linear-gradient(45deg, #28a745, #20c997); color: white; }
    .btn-delete { background: linear-gradient(45deg, #dc3545, #c82333); color: white; }
    .btn-action:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.2); color: white !important; }
</style>

<!-- AntiForgeryToken for AJAX -->

<form method="post">
    @Html.AntiForgeryToken()
</form>

<div class="content container-fluid">

<!-- HEADER -->
<div class="page-header">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h4 class="mb-0">
                <i class="fas fa-users me-2 text-primary"></i>
                Teachers <span class="badge bg-primary ms-2">@Model.Count()</span>
            </h4>
        </div>

        <div class="col-md-6 text-end">
            <div class="d-flex gap-2 justify-content-end align-items-center">

                <form method="get" class="d-flex gap-2">
                    <input type="text" name="search" value="@ViewBag.Search"
                           class="form-control shadow-sm"
                           style="width: 280px;"
                           placeholder="🔍 Search by name...">
                    <button class="btn btn-primary shadow-sm px-3">
                        <i class="fas fa-search"></i>
                    </button>
                </form>

                <a asp-action="Add" class="btn btn-primary shadow-sm px-4">
                    <i class="fas fa-plus me-2"></i>Add Teacher
                </a>
            </div>
        </div>
    </div>
</div>


<!-- GRID -->
<div class="row mt-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <h3 class="text-muted">No Teachers Yet</h3>
        </div>
    }
    else
    {
        foreach (var teacher in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-4 teacher-item">

                <div class="card teacher-card h-100">

                    <div class="text-center pt-4">
                        <div class="teacher-avatar">
                            @(teacher.Name?.Length > 0 ? teacher.Name[0].ToString().ToUpper() : "T")
                        </div>

                        <h5 class="teacher-name">
                            <a asp-action="Details" asp-route-id="@teacher.Id">@teacher.Name</a>
                        </h5>

                        <div class="teacher-meta">
                            <i class="fas fa-envelope me-1"></i> @teacher.Email
                        </div>
                    </div>

                    <div class="px-4 pb-4">
                        <div class="teacher-badges">
                            <span class="teacher-badge badge-success">
                                <i class="fas fa-book me-1"></i>@teacher.SubjectName
                            </span>
                            <span class="teacher-badge badge-primary">
                                <i class="fas fa-money-bill-wave me-1"></i>@teacher.Salary EGP
                            </span>
                        </div>
                    </div>

                    <div class="card-actions">
                        <a asp-action="Edit" asp-route-id="@teacher.Id" class="btn-action btn-edit">
                            <i class="fas fa-edit me-1"></i> Edit
                        </a>

                        <button onclick="deleteTeacher(@teacher.Id, '@teacher.Name')" 
                                class="btn-action btn-delete">
                            <i class="fas fa-trash me-1"></i> Delete
                        </button>
                    </div>

                </div>
            </div>
        }
    }
</div>

<!-- PAGINATION -->
@if (ViewBag.TotalPages > 1)
{
    <div class="d-flex justify-content-center mt-4">
        <ul class="pagination">

            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)&search=@ViewBag.Search">Prev</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i&search=@ViewBag.Search">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)&search=@ViewBag.Search">Next</a>
            </li>

        </ul>
    </div>
}


</div>

@section Scripts {


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function deleteTeacher(id, name) {

        Swal.fire({
            title: `Delete "${name}"?`,
            text: "This action cannot be undone!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#dc3545",
            confirmButtonText: "Yes, delete",
            cancelButtonText: "Cancel"
        }).then((result) => {

            if (result.isConfirmed) {

                fetch(`/Admin/Teacher/Delete/${id}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(res => res.json())
                .then(data => {

                    if (data.success) {

                        Swal.fire({
                            icon: "success",
                            title: "Deleted!",
                            timer: 1200,
                            showConfirmButton: false
                        });

                        setTimeout(() => location.reload(), 1200);

                    } else {
                        Swal.fire("Error", data.message, "error");
                    }

                });
            }
        });
    }
</script>

}
