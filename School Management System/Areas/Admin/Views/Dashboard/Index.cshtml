@model DashboardVM
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dash-stat-card {
        border: none;
        border-radius: 20px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        transition: all 0.4s ease;
        height: 120px;
        overflow: hidden;
        position: relative;
    }
    .dash-stat-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.15);
    }
    .stat-primary { border-left: 5px solid #007bff; }
    .stat-success { border-left: 5px solid #28a745; }
    .stat-info { border-left: 5px solid #17a2b8; }
    .stat-warning { border-left: 5px solid #ffc107; }
    .stat-danger { border-left: 5px solid #dc3545; }
    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: white;
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        margin-right: 15px;
    }
    .stat-primary .stat-icon { background: linear-gradient(135deg, #007bff, #0056b3); }
    .stat-success .stat-icon { background: linear-gradient(135deg, #28a745, #20c997); }
    .stat-info .stat-icon { background: linear-gradient(135deg, #17a2b8, #138496); }
    .stat-warning .stat-icon { background: linear-gradient(135deg, #ffc107, #ff8c00); }
    .stat-number {
        font-size: 32px;
        font-weight: 800;
        color: #2c3e50;
        line-height: 1.2;
    }
    .stat-label {
        font-size: 14px;
        color: #6c757d;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .recent-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
    }
    .recent-item {
        padding: 15px 0;
        border-bottom: 1px solid #eee;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 15px;
    }
    .recent-item:hover {
        background: #f8f9fa;
        transform: translateX(5px);
    }
    .recent-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        font-weight: 700;
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .recent-info h6 {
        margin: 0;
        font-weight: 600;
        color: #2c3e50;
        font-size: 15px;
    }
    .recent-date {
        color: #6c757d;
        font-size: 13px;
        margin: 0;
    }
</style>

<div class="content container-fluid">
    <!-- Page Header -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="page-title mb-0">
                    <i class="fas fa-tachometer-alt me-2 text-primary"></i>Dashboard
                </h3>
                <p class="mb-0 text-muted">Welcome back! Here's what's happening in your school today.</p>
            </div>
        </div>
    </div>

    <!-- Stats Cards - Row 1 -->
    <div class="row mb-4 g-4">
        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12">
            <div class="card dash-stat-card stat-primary h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon"></div>
                    <div>
                        <div class="stat-number">@Model.TotalStudents</div>
                        <div class="stat-label">Total Students</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12">
            <div class="card dash-stat-card stat-success h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon"><i class="fas fa-chalkboard-teacher"></i></div>
                    <div>
                        <div class="stat-number">@Model.TotalTeachers</div>
                        <div class="stat-label">Total Teachers</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12">
            <div class="card dash-stat-card stat-info h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon"><i class="fas fa-users"></i></div>
                    <div>
                        <div class="stat-number">@Model.TotalClasses</div>
                        <div class="stat-label">Total Classes</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12">
            <div class="card dash-stat-card stat-warning h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon"><i class="fas fa-clipboard-list"></i></div>
                    <div>
                        <div class="stat-number">@Model.TotalExams</div>
                        <div class="stat-label">Total Exams</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fees Summary -->
    <div class="row mb-4 g-4">
        <div class="col-md-6 col-sm-12">
            <div class="card dash-stat-card stat-success h-100 text-center">
                <div class="card-body py-4">
                    <i class="fas fa-check-circle fa-3x text-white mb-3 opacity-75"></i>
                    <div class="stat-number">@Model.TotalFeesPaid.ToString("N0") EGP</div>
                    <div class="stat-label">Fees Paid</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-sm-12">
            <div class="card dash-stat-card stat-danger h-100 text-center">
                <div class="card-body py-4">
                    <i class="fas fa-exclamation-circle fa-3x text-white mb-3 opacity-75"></i>
                    <div class="stat-number">@Model.TotalFeesDue.ToString("N0") EGP</div>
                    <div class="stat-label">Fees Due</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="row g-4">
        <!-- Recent Students -->
        <div class="col-lg-6 col-md-12">
            <div class="card recent-card h-100">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-user-graduate me-2 text-primary"></i>Recent Students
                    </h4>
                </div>
                <div class="card-body pt-3">
                    @if (Model.RecentStudents.Any())
                    {
                        @foreach (var student in Model.RecentStudents.Take(5))
                        {
                            <div class="recent-item">
                                <div class="recent-avatar">@(student.Name?.Length > 0 ? student.Name[0].ToString().ToUpper() : "S")</div>
                                <div class="recent-info flex-grow-1">
                                    <h6>@(student.Name ?? "Unnamed")</h6>
                                    <p class="recent-date">@student.Date.ToString("dd/MM/yyyy")</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-user-graduate fa-2x mb-3 opacity-50"></i>
                            <p>No recent students</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Fees -->
        <div class="col-lg-6 col-md-12">
            <div class="card recent-card h-100">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-money-bill-wave me-2 text-success"></i>Recent Fees
                    </h4>
                </div>
                <div class="card-body pt-3">
                    @if (Model.RecentFees.Any())
                    {
                        @foreach (var fee in Model.RecentFees.Take(5))
                        {
                            <div class="recent-item">
                                <div class="recent-avatar bg-success">@(fee.Name?.Length > 0 ? fee.Name[0].ToString().ToUpper() : "F")</div>
                                <div class="recent-info flex-grow-1">
                                    <h6>@(fee.Name ?? "Unnamed")</h6>
                                    <p class="recent-date">@fee.Date.ToString("dd/MM/yyyy")</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-money-bill-wave fa-2x mb-3 opacity-50"></i>
                            <p>No recent fees</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Animate stats on load
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.dash-stat-card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(30px)';
                setTimeout(() => {
                    card.style.transition = 'all 0.6s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 150);
            });

            // Hover effects for recent items
            document.querySelectorAll('.recent-item').forEach(item => {
                item.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateX(8px)';
                });
                item.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateX(0)';
                });
            });
        });

        // Counter animation
        function animateCounters() {
            const numbers = document.querySelectorAll('.stat-number');
            numbers.forEach(number => {
                const target = parseInt(number.textContent.replace(/,/g, ''));
                let count = 0;
                const increment = target / 50;
                const timer = setInterval(() => {
                    count += increment;
                    if (count >= target) {
                        number.textContent = target.toLocaleString();
                        clearInterval(timer);
                    } else {
                        number.textContent = Math.floor(count).toLocaleString();
                    }
                }, 30);
            });
        }

        // Run counter animation when visible
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    animateCounters();
                    observer.unobserve(entry.target);
                }
            });
        });

        observer.observe(document.querySelector('.dash-stat-card'));
    </script>
}
